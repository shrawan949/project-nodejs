<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10" x-data="{ addModal: false, editModal: false, editProduct: {}, importModal: false }">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-8 border-b border-slate-200/80 gap-4">
    <div>
      <nav class="flex items-center gap-2 text-xs text-slate-400 font-semibold mb-1">
        <a href="/admin" class="hover:text-indigo-600">Admin</a>
        <span>/</span>
        <span class="text-slate-700">Products</span>
      </nav>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">Product Catalog Management</h1>
      <p class="text-xs text-slate-400 mt-1"><%= totalProducts %> products total</p>
    </div>

    <div class="flex items-center gap-2">
      <button @click="importModal = true" class="px-4 py-2.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-xl text-xs font-bold shadow-sm flex items-center gap-2 transition-all">
        <i class="fas fa-file-csv"></i>
        <span>Import CSV</span>
      </button>
      <button @click="addModal = true" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold shadow-md shadow-indigo-600/20 flex items-center gap-2 transition-all">
        <i class="fas fa-plus"></i>
        <span>Add New Product</span>
      </button>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <form action="/admin/products" method="GET" class="flex flex-col sm:flex-row items-center gap-3 mt-6 mb-4">
    <div class="relative flex-1 w-full">
      <input type="text" name="keyword" value="<%= keyword %>" placeholder="Search by name or SKU..." class="w-full bg-white border border-slate-200 text-xs text-slate-800 rounded-xl pl-9 pr-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
      <i class="fas fa-search absolute left-3 top-3 text-slate-400 text-xs"></i>
    </div>
    <select name="category" onchange="this.form.submit()" class="bg-white border border-slate-200 text-xs font-semibold text-slate-700 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
      <option value="all" <%= currentCategory === 'all' ? 'selected' : '' %>>All Categories</option>
      <% if (categories) { categories.forEach(c => { %>
        <option value="<%= c.name %>" <%= currentCategory === c.name ? 'selected' : '' %>><%= c.name %></option>
      <% }) } %>
    </select>
    <button type="submit" class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-xl shadow-md transition-all">Search</button>
    <% if (keyword || currentCategory !== 'all') { %>
      <a href="/admin/products" class="text-xs text-slate-400 hover:text-slate-600 font-semibold">Reset</a>
    <% } %>
  </form>

  <!-- Products Table -->
  <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-400 uppercase tracking-wider border-b border-slate-100">
          <tr>
            <th class="py-3 px-4">Item</th>
            <th class="py-3 px-4">Category</th>
            <th class="py-3 px-4">Brand</th>
            <th class="py-3 px-4">Price</th>
            <th class="py-3 px-4">Inventory</th>
            <th class="py-3 px-4">Rating</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          <% if (products && products.length > 0) { %>
            <% products.forEach(product => { %>
              <tr class="hover:bg-slate-50/70 transition-colors">
                <td class="py-3.5 px-4 flex items-center gap-3">
                  <img src="<%= product.images[0] %>" alt="" class="w-10 h-10 rounded-xl object-cover bg-slate-100 shrink-0">
                  <div>
                    <a href="/product/<%= product.slug %>" class="font-bold text-slate-900 hover:text-indigo-600"><%= product.name %></a>
                    <p class="text-[10px] text-slate-400">SKU: <%= product.sku %></p>
                  </div>
                </td>
                <td class="py-3.5 px-4 text-slate-600"><%= product.category %></td>
                <td class="py-3.5 px-4 text-slate-600"><%= product.brand || '—' %></td>
                <td class="py-3.5 px-4">
                  <span class="font-bold text-slate-900">$<%= product.price.toFixed(2) %></span>
                  <% if (product.compareAtPrice && product.compareAtPrice > product.price) { %>
                    <span class="text-[10px] text-slate-400 line-through ml-1">$<%= product.compareAtPrice.toFixed(2) %></span>
                  <% } %>
                </td>
                <td class="py-3.5 px-4">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= product.countInStock > 5 ? 'bg-emerald-50 text-emerald-700' : product.countInStock > 0 ? 'bg-amber-50 text-amber-700' : 'bg-rose-50 text-rose-700' %>">
                    <%= product.countInStock %> in stock
                  </span>
                </td>
                <td class="py-3.5 px-4 text-slate-700">★ <%= product.rating.toFixed(1) %> (<%= product.numReviews %>)</td>
                <td class="py-3.5 px-4 text-right space-x-1">
                  <button onclick="openEditModal('<%= product._id %>')" class="p-2 text-indigo-500 hover:text-indigo-700 hover:bg-indigo-50 rounded-lg transition-colors" title="Edit">
                    <i class="fas fa-pen"></i>
                  </button>
                  <button onclick="deleteProduct('<%= product._id %>')" class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors" title="Delete">
                    <i class="fas fa-trash-can"></i>
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="py-8 text-center text-slate-400">No products found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  <% if (pages > 1) { %>
    <div class="mt-8 flex justify-center items-center gap-2">
      <% for (let i = 1; i <= pages; i++) { %>
        <a href="/admin/products?page=<%= i %>&keyword=<%= keyword %>&category=<%= currentCategory %>" 
           class="w-10 h-10 rounded-xl flex items-center justify-center text-xs font-bold transition-all <%= i === page ? 'bg-indigo-600 text-white shadow-md' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50' %>">
          <%= i %>
        </a>
      <% } %>
    </div>
  <% } %>

  <!-- Add Product Modal -->
  <div x-show="addModal" x-cloak class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div @click.away="addModal = false" class="bg-white rounded-3xl max-w-lg w-full max-h-[90vh] overflow-y-auto p-8 shadow-2xl border border-slate-100 space-y-6">
      
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <h3 class="text-lg font-black text-slate-900">Add New Product</h3>
        <button @click="addModal = false" class="text-slate-400 hover:text-slate-600 text-lg">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <form onsubmit="handleCreateProduct(event)" class="space-y-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Product Title</label>
          <input type="text" name="name" required placeholder="e.g. Precision Studio Mic" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Price ($)</label>
            <input type="number" step="0.01" name="price" required placeholder="149.99" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Compare-at Price ($)</label>
            <input type="number" step="0.01" name="compareAtPrice" placeholder="199.99" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Stock Count</label>
            <input type="number" name="countInStock" required placeholder="50" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Brand</label>
            <input type="text" name="brand" placeholder="NexusTech" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Category</label>
          <select name="category" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <% if (categories) { categories.forEach(c => { %>
              <option value="<%= c.name %>"><%= c.name %></option>
            <% }) } %>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Image URL</label>
          <input type="url" name="images" required placeholder="https://images.unsplash.com/..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Description</label>
          <textarea name="description" required rows="3" placeholder="Enter detailed product description..." class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input type="checkbox" id="isFeatured" name="isFeatured" value="true" class="rounded text-indigo-600 focus:ring-indigo-500">
          <label for="isFeatured" class="font-semibold text-slate-700">Mark as Featured Product</label>
        </div>

        <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md transition-all">
          Create Product
        </button>
      </form>

    </div>
  </div>

  <!-- Edit Product Modal -->
  <div x-show="editModal" x-cloak class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div @click.away="editModal = false" class="bg-white rounded-3xl max-w-lg w-full max-h-[90vh] overflow-y-auto p-8 shadow-2xl border border-slate-100 space-y-6">
      
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <h3 class="text-lg font-black text-slate-900">Edit Product</h3>
        <button @click="editModal = false" class="text-slate-400 hover:text-slate-600 text-lg">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <form onsubmit="handleEditProduct(event)" id="edit-form" class="space-y-4 text-xs">
        <input type="hidden" id="edit-id" name="id">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Product Title</label>
          <input type="text" id="edit-name" name="name" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Price ($)</label>
            <input type="number" step="0.01" id="edit-price" name="price" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Compare-at Price ($)</label>
            <input type="number" step="0.01" id="edit-compareAtPrice" name="compareAtPrice" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Stock Count</label>
            <input type="number" id="edit-countInStock" name="countInStock" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Brand</label>
            <input type="text" id="edit-brand" name="brand" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Category</label>
          <select id="edit-category" name="category" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <% if (categories) { categories.forEach(c => { %>
              <option value="<%= c.name %>"><%= c.name %></option>
            <% }) } %>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Description</label>
          <textarea id="edit-description" name="description" required rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input type="checkbox" id="edit-isFeatured" name="isFeatured" value="true" class="rounded text-indigo-600 focus:ring-indigo-500">
          <label for="edit-isFeatured" class="font-semibold text-slate-700">Featured Product</label>
        </div>

        <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md transition-all">
          Save Changes
        </button>
      </form>

    </div>
  </div>

  <!-- CSV Import Modal -->
  <div x-show="importModal" x-cloak class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div @click.away="importModal = false" class="bg-white rounded-3xl max-w-md w-full p-8 shadow-2xl border border-slate-100 space-y-6">
      
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <h3 class="text-lg font-black text-slate-900">Import Products (CSV)</h3>
        <button @click="importModal = false" class="text-slate-400 hover:text-slate-600 text-lg">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-3 text-xs text-blue-800">
        <p class="font-bold mb-1"><i class="fas fa-info-circle text-blue-600"></i> CSV Format</p>
        <p>Required columns: <code class="bg-blue-100 px-1 rounded">name</code>, <code class="bg-blue-100 px-1 rounded">price</code>, <code class="bg-blue-100 px-1 rounded">category</code>, <code class="bg-blue-100 px-1 rounded">description</code></p>
        <p class="mt-1">Optional: <code class="bg-blue-100 px-1 rounded">brand</code>, <code class="bg-blue-100 px-1 rounded">countInStock</code>, <code class="bg-blue-100 px-1 rounded">compareAtPrice</code>, <code class="bg-blue-100 px-1 rounded">images</code> (pipe-separated), <code class="bg-blue-100 px-1 rounded">tags</code> (pipe-separated), <code class="bg-blue-100 px-1 rounded">isFeatured</code></p>
      </div>

      <form onsubmit="handleImportCSV(event)" enctype="multipart/form-data" class="space-y-4">
        <div class="border-2 border-dashed border-slate-200 rounded-2xl p-6 text-center hover:border-indigo-300 transition-colors">
          <input type="file" name="file" id="csv-file" accept=".csv" required class="hidden">
          <label for="csv-file" class="cursor-pointer space-y-2 block">
            <i class="fas fa-cloud-upload-alt text-3xl text-slate-300"></i>
            <p class="text-xs font-bold text-slate-700">Click to upload CSV file</p>
            <p id="csv-filename" class="text-[10px] text-slate-400">Max 5MB</p>
          </label>
        </div>

        <div id="import-result" class="hidden bg-slate-50 border border-slate-200 rounded-2xl p-3 text-xs"></div>

        <button type="submit" id="import-btn" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-xs shadow-md transition-all">
          Upload & Import
        </button>
      </form>

    </div>
  </div>

</div>

<script>
// Show filename when selected
document.getElementById('csv-file')?.addEventListener('change', function() {
  document.getElementById('csv-filename').textContent = this.files[0]?.name || 'Max 5MB';
});

async function handleCreateProduct(e) {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData.entries());

  try {
    const res = await fetch('/api/v1/products', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const result = await res.json();
    if (res.ok) {
      Cart.showToast('Product created successfully!', 'success');
      setTimeout(() => location.reload(), 600);
    } else {
      Cart.showToast(result.message || 'Error creating product', 'error');
    }
  } catch {
    Cart.showToast('Network error', 'error');
  }
}

async function openEditModal(id) {
  try {
    const res = await fetch(`/api/v1/products/${id}`);
    const data = await res.json();
    if (!res.ok) return Cart.showToast('Failed to load product', 'error');

    const p = data.product;
    document.getElementById('edit-id').value = p._id;
    document.getElementById('edit-name').value = p.name;
    document.getElementById('edit-price').value = p.price;
    document.getElementById('edit-compareAtPrice').value = p.compareAtPrice || '';
    document.getElementById('edit-countInStock').value = p.countInStock;
    document.getElementById('edit-brand').value = p.brand || '';
    document.getElementById('edit-category').value = p.category;
    document.getElementById('edit-description').value = p.description;
    document.getElementById('edit-isFeatured').checked = p.isFeatured;

    // Open modal via Alpine
    document.querySelector('[x-data]').__x.$data.editModal = true;
  } catch {
    Cart.showToast('Failed to load product data', 'error');
  }
}

async function handleEditProduct(e) {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData.entries());
  const id = data.id;
  delete data.id;
  data.isFeatured = data.isFeatured === 'true';

  try {
    const res = await fetch(`/api/v1/products/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const result = await res.json();
    if (res.ok) {
      Cart.showToast('Product updated!', 'success');
      setTimeout(() => location.reload(), 600);
    } else {
      Cart.showToast(result.message || 'Error updating product', 'error');
    }
  } catch {
    Cart.showToast('Network error', 'error');
  }
}

async function deleteProduct(id) {
  if (!confirm('Are you sure you want to delete this product?')) return;
  try {
    const res = await fetch(`/api/v1/products/${id}`, { method: 'DELETE' });
    if (res.ok) {
      Cart.showToast('Product deleted', 'success');
      setTimeout(() => location.reload(), 500);
    } else {
      Cart.showToast('Failed to delete product', 'error');
    }
  } catch {
    Cart.showToast('Network error', 'error');
  }
}

async function handleImportCSV(e) {
  e.preventDefault();
  const btn = document.getElementById('import-btn');
  const resultDiv = document.getElementById('import-result');
  btn.disabled = true;
  btn.innerText = 'Importing...';

  const formData = new FormData(e.target);

  try {
    const res = await fetch('/api/v1/products/import', {
      method: 'POST',
      body: formData,
    });
    const data = await res.json();

    resultDiv.classList.remove('hidden');
    if (res.ok) {
      resultDiv.innerHTML = `
        <p class="font-bold text-emerald-700"><i class="fas fa-check-circle"></i> ${data.message}</p>
        ${data.errors.length > 0 ? '<p class="text-amber-700 mt-1">Errors: ' + data.errors.map(e => `Row ${e.row}: ${e.message}`).join(', ') + '</p>' : ''}
      `;
      if (data.imported > 0) setTimeout(() => location.reload(), 2000);
    } else {
      resultDiv.innerHTML = `<p class="text-rose-700 font-bold"><i class="fas fa-exclamation-circle"></i> ${data.message}</p>`;
    }
  } catch {
    resultDiv.classList.remove('hidden');
    resultDiv.innerHTML = '<p class="text-rose-700 font-bold">Network error</p>';
  }

  btn.disabled = false;
  btn.innerText = 'Upload & Import';
}
</script>
