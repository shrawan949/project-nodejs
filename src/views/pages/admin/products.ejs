<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10" x-data="{ addModal: false }">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-8 border-b border-slate-200/80 gap-4">
    <div>
      <nav class="flex items-center gap-2 text-xs text-slate-400 font-semibold mb-1">
        <a href="/admin" class="hover:text-blue-600">Admin</a>
        <span>/</span>
        <span class="text-slate-700">Inventory</span>
      </nav>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">Product Catalog Management</h1>
    </div>

    <button @click="addModal = true" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-md shadow-blue-600/20 flex items-center gap-2 transition-all">
      <i class="fas fa-plus"></i>
      <span>Add New Product</span>
    </button>
  </div>

  <!-- Products Table -->
  <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm mt-8 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-400 uppercase tracking-wider border-b border-slate-100">
          <tr>
            <th class="py-3 px-4">Item & Brand</th>
            <th class="py-3 px-4">Department</th>
            <th class="py-3 px-4">Price (INR)</th>
            <th class="py-3 px-4">Stock Status</th>
            <th class="py-3 px-4">Customer Rating</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          <% products.forEach(product => { %>
            <tr class="hover:bg-slate-50/70 transition-colors">
              <td class="py-3.5 px-4 flex items-center gap-3">
                <img src="<%= product.images[0] %>" alt="" class="w-10 h-10 rounded-xl object-contain p-1 bg-slate-50 border border-slate-100 shrink-0">
                <div>
                  <a href="/product/<%= product.slug %>" class="font-bold text-slate-900 hover:text-blue-600"><%= product.name %></a>
                  <p class="text-[10px] text-slate-400">Brand: <%= product.brand %> • SKU: <%= product.sku %></p>
                </div>
              </td>
              <td class="py-3.5 px-4 text-slate-600"><%= product.category %></td>
              <td class="py-3.5 px-4 font-black text-slate-900">₹<%= Number(product.price).toLocaleString('en-IN') %></td>
              <td class="py-3.5 px-4">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= product.countInStock > 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700' %>">
                  <%= product.countInStock %> in stock
                </span>
              </td>
              <td class="py-3.5 px-4 text-slate-700">★ <%= product.rating.toFixed(1) %> (<%= product.numReviews %>)</td>
              <td class="py-3.5 px-4 text-right">
                <button onclick="deleteProduct('<%= product._id %>')" class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors">
                  <i class="fas fa-trash-can"></i>
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Product Modal -->
  <div x-show="addModal" x-cloak class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div @click.away="addModal = false" class="bg-white rounded-3xl max-w-lg w-full p-8 shadow-2xl border border-slate-100 space-y-6">
      
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <h3 class="text-lg font-black text-slate-900">Add New Product</h3>
        <button @click="addModal = false" class="text-slate-400 hover:text-slate-600 text-lg">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <form onsubmit="handleCreateProduct(event)" class="space-y-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Product Title</label>
          <input type="text" name="name" required placeholder="e.g. Samsung 55 Inch Crystal 4K UHD TV" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Brand</label>
            <input type="text" name="brand" required placeholder="Samsung / Puma / SS" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Price (₹ INR)</label>
            <input type="number" step="1" name="price" required placeholder="49990" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Stock Count</label>
            <input type="number" name="countInStock" required placeholder="25" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Category</label>
            <select name="category" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="TVs & Appliances">TVs & Appliances</option>
              <option value="Smartphones & Tablets">Smartphones & Tablets</option>
              <option value="Puma & Footwear">Puma & Footwear</option>
              <option value="Sportswear & Apparel">Sportswear & Apparel</option>
              <option value="Sports & Fitness Gear">Sports & Fitness Gear</option>
              <option value="Laptops & Tech">Laptops & Tech</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Image URL</label>
          <input type="url" name="images" required placeholder="https://images.unsplash.com/..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Product Description</label>
          <textarea name="description" required rows="3" placeholder="Enter complete specifications and feature details..." class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input type="checkbox" id="isFeatured" name="isFeatured" value="true" class="rounded text-blue-600 focus:ring-blue-500">
          <label for="isFeatured" class="font-semibold text-slate-700">Display in Featured Showcase on Homepage</label>
        </div>

        <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-md transition-all">
          Create & Publish Listing
        </button>
      </form>

    </div>
  </div>

</div>

<script>
async function handleCreateProduct(e) {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData.entries());

  try {
    const res = await fetch('/api/v1/products', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const result = await res.json();
    if (res.ok) {
      Cart.showToast('Product created successfully!', 'success');
      setTimeout(() => location.reload(), 600);
    } else {
      Cart.showToast(result.message || 'Error creating product', 'error');
    }
  } catch {
    Cart.showToast('Network error', 'error');
  }
}

async function deleteProduct(id) {
  if (!confirm('Are you sure you want to delete this product?')) return;
  try {
    const res = await fetch(`/api/v1/products/${id}`, { method: 'DELETE' });
    if (res.ok) {
      Cart.showToast('Product deleted', 'success');
      setTimeout(() => location.reload(), 500);
    } else {
      Cart.showToast('Failed to delete product', 'error');
    }
  } catch {
    Cart.showToast('Network error', 'error');
  }
}
</script>
