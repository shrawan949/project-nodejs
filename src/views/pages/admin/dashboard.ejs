<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <!-- Admin Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-8 border-b border-slate-200/80 gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Control Center</span>
      </div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight mt-1">Admin Dashboard</h1>
    </div>

    <div class="flex items-center gap-3 flex-wrap">
      <a href="/admin/categories" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-50 transition-colors">Categories</a>
      <a href="/admin/brands" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-50 transition-colors">Brands</a>
      <a href="/admin/products" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-50 transition-colors">Catalog</a>
      <a href="/admin/coupons" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-50 transition-colors">Coupons</a>
      <a href="/admin/orders" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 rounded-xl text-xs font-bold text-white shadow-md shadow-indigo-600/20 transition-all">Orders</a>
    </div>
  </div>

  <!-- KPI Metric Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 my-8">
    
    <!-- Revenue -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm">
      <div class="flex items-center justify-between text-slate-400 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider">Total Revenue</span>
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm">
          <i class="fas fa-dollar-sign"></i>
        </div>
      </div>
      <h3 class="text-2xl font-black text-slate-900">$<%= stats.totalRevenue.toFixed(2) %></h3>
      <p class="text-[11px] text-emerald-600 font-semibold mt-1 flex items-center gap-1">
        <i class="fas fa-arrow-trend-up"></i> Paid orders
      </p>
    </div>

    <!-- Orders -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm">
      <div class="flex items-center justify-between text-slate-400 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider">Total Orders</span>
        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-sm">
          <i class="fas fa-shopping-bag"></i>
        </div>
      </div>
      <h3 class="text-2xl font-black text-slate-900"><%= stats.totalOrders %></h3>
      <p class="text-[11px] text-indigo-600 font-semibold mt-1">Lifetime orders placed</p>
    </div>

    <!-- Products -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm">
      <div class="flex items-center justify-between text-slate-400 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider">Active Catalog</span>
        <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-sm">
          <i class="fas fa-boxes-stacked"></i>
        </div>
      </div>
      <h3 class="text-2xl font-black text-slate-900"><%= stats.totalProducts %></h3>
      <p class="text-[11px] text-purple-600 font-semibold mt-1">Product listings</p>
    </div>

    <!-- Users -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm">
      <div class="flex items-center justify-between text-slate-400 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider">Registered Users</span>
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-sm">
          <i class="fas fa-users"></i>
        </div>
      </div>
      <h3 class="text-2xl font-black text-slate-900"><%= stats.totalUsers %></h3>
      <p class="text-[11px] text-amber-600 font-semibold mt-1">Customer accounts</p>
    </div>

    <!-- Low Stock -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm">
      <div class="flex items-center justify-between text-slate-400 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider">Low Stock</span>
        <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-sm">
          <i class="fas fa-triangle-exclamation"></i>
        </div>
      </div>
      <h3 class="text-2xl font-black text-slate-900"><%= stats.lowStockCount %></h3>
      <p class="text-[11px] text-rose-600 font-semibold mt-1">≤ 5 units remaining</p>
    </div>

  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">

    <!-- Order Status Breakdown -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6">
      <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider mb-4">Order Status Breakdown</h3>
      <div class="space-y-3">
        <% 
          const statusColors = {
            'Pending': 'bg-amber-100 text-amber-700',
            'Processing': 'bg-blue-100 text-blue-700',
            'Shipped': 'bg-cyan-100 text-cyan-700',
            'Delivered': 'bg-emerald-100 text-emerald-700',
            'Cancelled': 'bg-rose-100 text-rose-700',
          };
          const statusIcons = {
            'Pending': 'fa-clock',
            'Processing': 'fa-gears',
            'Shipped': 'fa-truck',
            'Delivered': 'fa-circle-check',
            'Cancelled': 'fa-ban',
          };
        %>
        <% if (statusCounts && statusCounts.length > 0) { %>
          <% statusCounts.forEach(sc => { %>
            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg <%= statusColors[sc._id] || 'bg-slate-100 text-slate-600' %> flex items-center justify-center text-[10px]">
                  <i class="fas <%= statusIcons[sc._id] || 'fa-circle' %>"></i>
                </div>
                <span class="text-xs font-bold text-slate-800"><%= sc._id %></span>
              </div>
              <span class="text-sm font-black text-slate-900"><%= sc.count %></span>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-xs text-slate-400 text-center py-4">No orders yet</p>
        <% } %>
      </div>
    </div>

    <!-- Top Products -->
    <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6">
      <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider mb-4">Top Reviewed Products</h3>
      <div class="space-y-3">
        <% if (topProducts && topProducts.length > 0) { %>
          <% topProducts.forEach((p, i) => { %>
            <div class="flex items-center gap-4 p-3 rounded-xl bg-slate-50">
              <span class="w-7 h-7 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-bold"><%= i + 1 %></span>
              <img src="<%= p.images[0] %>" alt="" class="w-10 h-10 rounded-xl object-cover bg-white shrink-0">
              <div class="flex-1 min-w-0">
                <a href="/product/<%= p.slug %>" class="text-xs font-bold text-slate-900 hover:text-indigo-600 truncate block"><%= p.name %></a>
                <p class="text-[10px] text-slate-400"><%= p.brand %> • $<%= p.price.toFixed(2) %></p>
              </div>
              <div class="text-right shrink-0">
                <div class="flex items-center gap-1 text-amber-400 text-[10px]">
                  <i class="fas fa-star"></i>
                  <span class="font-bold text-slate-700"><%= p.rating.toFixed(1) %></span>
                </div>
                <p class="text-[10px] text-slate-400"><%= p.numReviews %> reviews</p>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-xs text-slate-400 text-center py-4">No products yet</p>
        <% } %>
      </div>
    </div>

  </div>

  <!-- Recent Orders Table -->
  <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 sm:p-8 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-lg font-black text-slate-900">Recent Transactions</h3>
        <p class="text-xs text-slate-400">Latest customer purchases across storefront</p>
      </div>
      <a href="/admin/orders" class="text-xs font-bold text-indigo-600 hover:text-indigo-700">View All Orders &rarr;</a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-400 uppercase tracking-wider border-y border-slate-100">
          <tr>
            <th class="py-3 px-4">Order ID</th>
            <th class="py-3 px-4">Customer</th>
            <th class="py-3 px-4">Total</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          <% if (recentOrders && recentOrders.length > 0) { %>
            <% recentOrders.forEach(order => { %>
              <tr class="hover:bg-slate-50/70 transition-colors">
                <td class="py-3.5 px-4 font-bold text-slate-900"><%= order.orderNumber %></td>
                <td class="py-3.5 px-4 text-slate-600"><%= order.user ? order.user.name : 'Guest' %></td>
                <td class="py-3.5 px-4 font-bold text-slate-900">$<%= order.totalPrice.toFixed(2) %></td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold <%= statusColors[order.status] || 'bg-slate-100 text-slate-700' %>">
                    <%= order.status %>
                  </span>
                </td>
                <td class="py-3.5 px-4 text-slate-400"><%= new Date(order.createdAt).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="py-8 text-center text-slate-400">No orders recorded yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>
