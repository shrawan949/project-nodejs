<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <!-- Admin Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-8 border-b border-slate-200/80 gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-xs font-black uppercase tracking-wider text-slate-400">Nexus Operations Control</span>
      </div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight mt-1">Enterprise Dashboard</h1>
    </div>

    <div class="flex items-center gap-3">
      <a href="/admin/products" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-50 transition-colors">
        Manage Catalog
      </a>
      <a href="/admin/orders" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-xl text-xs font-black text-white shadow-md shadow-blue-600/20 transition-all">
        Fulfillment Center
      </a>
    </div>
  </div>

  <!-- KPI Metric Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 my-8">
    
    <!-- Revenue -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm">
      <div class="flex items-center justify-between text-slate-400 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider">Gross Merchandise Value</span>
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm font-black">
          ₹
        </div>
      </div>
      <h3 class="text-2xl font-black text-slate-900">₹<%= Number(stats.totalRevenue).toLocaleString('en-IN') %></h3>
      <p class="text-[11px] text-emerald-600 font-semibold mt-1 flex items-center gap-1">
        <i class="fas fa-arrow-trend-up"></i> Real-time aggregate sales in INR
      </p>
    </div>

    <!-- Orders -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm">
      <div class="flex items-center justify-between text-slate-400 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider">Total Orders</span>
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-sm">
          <i class="fas fa-shopping-bag"></i>
        </div>
      </div>
      <h3 class="text-2xl font-black text-slate-900"><%= stats.totalOrders %></h3>
      <p class="text-[11px] text-blue-600 font-semibold mt-1">
        Fulfillment across India
      </p>
    </div>

    <!-- Products -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm">
      <div class="flex items-center justify-between text-slate-400 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider">Active Inventory</span>
        <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-sm">
          <i class="fas fa-boxes-stacked"></i>
        </div>
      </div>
      <h3 class="text-2xl font-black text-slate-900"><%= stats.totalProducts %></h3>
      <p class="text-[11px] text-purple-600 font-semibold mt-1">
        Samsung, Puma & Sports
      </p>
    </div>

    <!-- Users -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm">
      <div class="flex items-center justify-between text-slate-400 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider">Registered Customers</span>
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-sm">
          <i class="fas fa-users"></i>
        </div>
      </div>
      <h3 class="text-2xl font-black text-slate-900"><%= stats.totalUsers %></h3>
      <p class="text-[11px] text-amber-600 font-semibold mt-1">
        Active verified accounts
      </p>
    </div>

  </div>

  <!-- Recent Orders Table -->
  <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 sm:p-8 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-lg font-black text-slate-900">Recent Customer Orders</h3>
        <p class="text-xs text-slate-400">Live order flow and fulfillment tracking</p>
      </div>
      <a href="/admin/orders" class="text-xs font-bold text-blue-600 hover:text-blue-800">Fulfillment Center &rarr;</a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-400 uppercase tracking-wider border-y border-slate-100">
          <tr>
            <th class="py-3 px-4">Order Ref</th>
            <th class="py-3 px-4">Customer</th>
            <th class="py-3 px-4">Invoiced Total</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          <% if (recentOrders && recentOrders.length > 0) { %>
            <% recentOrders.forEach(order => { %>
              <tr class="hover:bg-slate-50/70 transition-colors">
                <td class="py-3.5 px-4 font-bold text-slate-900"><%= order.orderNumber %></td>
                <td class="py-3.5 px-4 text-slate-600"><%= order.user ? order.user.name : 'Guest' %></td>
                <td class="py-3.5 px-4 font-black text-slate-900">₹<%= Number(order.totalPrice).toLocaleString('en-IN') %></td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700">
                    <%= order.status %>
                  </span>
                </td>
                <td class="py-3.5 px-4 text-slate-400"><%= new Date(order.createdAt).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="py-8 text-center text-slate-400">No orders recorded yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>
