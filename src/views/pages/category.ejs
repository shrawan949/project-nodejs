<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-xs text-slate-400 font-semibold mb-2">
    <a href="/" class="hover:text-indigo-600">Home</a>
    <span>/</span>
    <a href="/shop" class="hover:text-indigo-600">Shop</a>
    <span>/</span>
    <span class="text-slate-700"><%= category.name %></span>
  </nav>

  <!-- Category Header -->
  <div class="mb-10">
    <h1 class="text-3xl font-black text-slate-900 tracking-tight"><%= category.name %></h1>
    <% if (category.description) { %>
      <p class="text-sm text-slate-500 mt-2 max-w-2xl"><%= category.description %></p>
    <% } %>
    <p class="text-xs text-slate-400 mt-1"><%= totalProducts %> products found</p>
  </div>

  <!-- Subcategories -->
  <% if (subcategories && subcategories.length > 0) { %>
  <div class="flex flex-wrap gap-3 mb-8">
    <a href="/category/<%= category.slug %>" 
       class="px-4 py-2 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-md">
      All <%= category.name %>
    </a>
    <% subcategories.forEach(sub => { %>
      <a href="/shop?category=<%= encodeURIComponent(sub.name) %>" 
         class="px-4 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-indigo-50 hover:border-indigo-200 hover:text-indigo-700 transition-all">
        <%= sub.name %>
      </a>
    <% }) %>
  </div>
  <% } %>

  <!-- Sort Controls -->
  <div class="flex items-center justify-between mb-8">
    <p class="text-xs text-slate-500">Showing page <%= page %> of <%= pages || 1 %></p>
    <form method="GET" class="flex items-center gap-2">
      <label class="text-xs font-bold text-slate-500">Sort:</label>
      <select name="sort" onchange="this.form.submit()" class="bg-white border border-slate-200 text-xs font-semibold text-slate-700 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>Newest</option>
        <option value="price-asc" <%= currentSort === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
        <option value="price-desc" <%= currentSort === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
        <option value="rating" <%= currentSort === 'rating' ? 'selected' : '' %>>Highest Rated</option>
      </select>
    </form>
  </div>

  <!-- Products Grid -->
  <% if (products && products.length > 0) { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% products.forEach(product => { %>
        <%- include('../partials/product-card', { product }) %>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (pages > 1) { %>
      <div class="mt-12 flex justify-center items-center gap-2">
        <% if (page > 1) { %>
          <a href="/category/<%= category.slug %>?page=<%= page - 1 %>&sort=<%= currentSort %>" 
             class="w-10 h-10 rounded-xl flex items-center justify-center text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50">
            <i class="fas fa-chevron-left"></i>
          </a>
        <% } %>
        <% for (let i = 1; i <= pages; i++) { %>
          <a href="/category/<%= category.slug %>?page=<%= i %>&sort=<%= currentSort %>" 
             class="w-10 h-10 rounded-xl flex items-center justify-center text-xs font-bold transition-all <%= i === page ? 'bg-indigo-600 text-white shadow-md' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50' %>">
            <%= i %>
          </a>
        <% } %>
        <% if (page < pages) { %>
          <a href="/category/<%= category.slug %>?page=<%= page + 1 %>&sort=<%= currentSort %>" 
             class="w-10 h-10 rounded-xl flex items-center justify-center text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50">
            <i class="fas fa-chevron-right"></i>
          </a>
        <% } %>
      </div>
    <% } %>
  <% } else { %>
    <div class="bg-white rounded-3xl border border-slate-200/80 p-16 text-center">
      <i class="fas fa-folder-open text-4xl text-slate-300 mb-3"></i>
      <h3 class="text-lg font-bold text-slate-800">No products in this category yet</h3>
      <p class="text-xs text-slate-400 mt-1">Check back soon for new additions!</p>
      <a href="/shop" class="inline-block mt-4 px-6 py-2.5 bg-slate-900 text-white text-xs font-bold rounded-xl shadow-md">Browse All Products</a>
    </div>
  <% } %>

</div>
