<div class="max-w-md mx-auto px-4 py-24 text-center">
  <div class="w-16 h-16 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto text-2xl mb-4">
    <i class="fas fa-triangle-exclamation"></i>
  </div>
  <h1 class="text-4xl font-black text-slate-900 tracking-tight"><%= statusCode || 404 %></h1>
  <p class="text-sm font-bold text-slate-700 mt-2"><%= typeof title !== 'undefined' ? title : 'Error Encountered' %></p>
  <p class="text-xs text-slate-500 mt-1 mb-8"><%= typeof message !== 'undefined' ? message : 'The page you requested could not be located or an unexpected error occurred.' %></p>
  <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-md transition-all">
    <i class="fas fa-arrow-left text-xs"></i>
    <span>Return to Storefront</span>
  </a>
</div>
