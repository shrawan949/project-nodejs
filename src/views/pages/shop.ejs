<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <!-- Breadcrumbs & Header -->
  <div class="mb-8">
    <nav class="flex items-center gap-2 text-xs text-slate-400 font-semibold mb-2">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span>/</span>
      <span class="text-slate-800">All Departments</span>
    </nav>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Catalog & Storefront</h1>
        <p class="text-xs text-slate-500 mt-1">Showing <%= products.length %> items in stock with India-wide shipping</p>
      </div>

      <!-- Sorting Controls -->
      <form id="sort-form" method="GET" class="flex items-center gap-2">
        <% if (keyword) { %><input type="hidden" name="keyword" value="<%= keyword %>"><% } %>
        <% if (currentCategory && currentCategory !== 'all') { %><input type="hidden" name="category" value="<%= currentCategory %>"><% } %>
        
        <label for="sort-select" class="text-xs font-bold text-slate-500 whitespace-nowrap">Sort by:</label>
        <select id="sort-select" name="sort" onchange="this.form.submit()" class="bg-white border border-slate-200 text-xs font-semibold text-slate-700 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>Featured & Newest</option>
          <option value="price-asc" <%= currentSort === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
          <option value="price-desc" <%= currentSort === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
          <option value="rating" <%= currentSort === 'rating' ? 'selected' : '' %>>Customer Rating</option>
        </select>
      </form>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    
    <!-- Sidebar Filters -->
    <aside class="space-y-6">
      <form action="/shop" method="GET" class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm space-y-6">
        
        <!-- Search Keyword -->
        <div>
          <label class="block text-xs font-black text-slate-900 uppercase tracking-wider mb-2">Search Products</label>
          <div class="relative">
            <input type="text" name="keyword" value="<%= keyword %>" placeholder="Samsung, Puma, Bat..." class="w-full bg-slate-50 border border-slate-200 text-xs text-slate-800 rounded-xl pl-8 pr-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
            <i class="fas fa-search absolute left-3 top-3 text-slate-400 text-xs"></i>
          </div>
        </div>

        <!-- Brands Quick Filter -->
        <div>
          <label class="block text-xs font-black text-slate-900 uppercase tracking-wider mb-2">Top Brands</label>
          <div class="grid grid-cols-2 gap-2 text-xs">
            <a href="/shop?keyword=Samsung" class="p-2 rounded-xl border border-slate-200 text-center font-bold text-slate-700 hover:border-blue-500 hover:text-blue-600 bg-slate-50">
              Samsung
            </a>
            <a href="/shop?keyword=Puma" class="p-2 rounded-xl border border-slate-200 text-center font-bold text-slate-700 hover:border-rose-500 hover:text-rose-600 bg-slate-50">
              Puma
            </a>
            <a href="/shop?keyword=Apple" class="p-2 rounded-xl border border-slate-200 text-center font-bold text-slate-700 hover:border-slate-800 hover:text-slate-900 bg-slate-50">
              Apple
            </a>
            <a href="/shop?keyword=Sony" class="p-2 rounded-xl border border-slate-200 text-center font-bold text-slate-700 hover:border-indigo-500 hover:text-indigo-600 bg-slate-50">
              Sony
            </a>
          </div>
        </div>

        <!-- Categories List -->
        <div>
          <label class="block text-xs font-black text-slate-900 uppercase tracking-wider mb-3">Categories</label>
          <div class="space-y-2">
            <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
              <input type="radio" name="category" value="all" <%= currentCategory === 'all' ? 'checked' : '' %> onchange="this.form.submit()" class="text-blue-600 focus:ring-blue-500">
              <span>All Categories</span>
            </label>
            <% categories.forEach(cat => { %>
              <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                <input type="radio" name="category" value="<%= cat %>" <%= currentCategory === cat ? 'checked' : '' %> onchange="this.form.submit()" class="text-blue-600 focus:ring-blue-500">
                <span><%= cat %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-md transition-all">
          Apply Filter
        </button>

        <a href="/shop" class="block text-center text-xs text-slate-400 hover:text-slate-600 font-semibold">
          Reset All Filters
        </a>

      </form>
    </aside>

    <!-- Main Products Grid -->
    <div class="lg:col-span-3">
      <% if (products && products.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
          <% products.forEach(product => { %>
            <%- include('../partials/product-card', { product }) %>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (pages > 1) { %>
          <div class="mt-12 flex justify-center items-center gap-2">
            <% for (let i = 1; i <= pages; i++) { %>
              <a href="/shop?page=<%= i %>&category=<%= currentCategory %>&keyword=<%= keyword %>&sort=<%= currentSort %>" 
                 class="w-10 h-10 rounded-xl flex items-center justify-center text-xs font-bold transition-all <%= i === page ? 'bg-blue-600 text-white shadow-md' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50' %>">
                <%= i %>
              </a>
            <% } %>
          </div>
        <% } %>

      <% } else { %>
        <div class="bg-white rounded-3xl border border-slate-200/80 p-12 text-center">
          <i class="fas fa-search text-4xl text-slate-300 mb-3"></i>
          <h3 class="text-lg font-bold text-slate-800">No matching products found</h3>
          <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">Try clearing search filters or choosing another brand.</p>
          <a href="/shop" class="inline-block mt-4 px-6 py-2.5 bg-blue-600 text-white text-xs font-bold rounded-xl shadow-md">Show All Products</a>
        </div>
      <% } %>
    </div>

  </div>

</div>
