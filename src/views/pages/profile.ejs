<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

  <!-- Header -->
  <div class="flex items-center justify-between pb-8 border-b border-slate-200/80 mb-8">
    <div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">My Account</h1>
      <p class="text-xs text-slate-400 mt-1">Manage your profile, addresses, and orders</p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/my-orders" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-50 transition-colors">
        <i class="fas fa-box mr-1.5"></i>My Orders (<%= orderCount %>)
      </a>
      <a href="/wishlist" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-50 transition-colors">
        <i class="fas fa-heart mr-1.5 text-rose-500"></i>Wishlist
      </a>
    </div>
  </div>

  <!-- Profile Info Card -->
  <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm mb-8" x-data="{ editing: false }">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-black text-slate-900">Profile Information</h2>
      <button @click="editing = !editing" x-text="editing ? 'Cancel' : 'Edit'" 
              class="px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors"></button>
    </div>

    <div x-show="!editing">
      <div class="flex items-center gap-5 mb-6">
        <img src="<%= user.avatar %>" alt="Avatar" class="w-16 h-16 rounded-2xl object-cover border border-slate-200">
        <div>
          <h3 class="text-lg font-bold text-slate-900"><%= user.name %></h3>
          <p class="text-xs text-slate-400"><%= user.email %></p>
          <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-[10px] font-bold <%= user.role === 'admin' ? 'bg-indigo-100 text-indigo-700' : 'bg-slate-100 text-slate-600' %>">
            <%= user.role.toUpperCase() %>
          </span>
        </div>
      </div>
    </div>

    <form x-show="editing" x-cloak onsubmit="updateProfile(event)" class="space-y-4 text-xs">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Full Name</label>
          <input type="text" name="name" value="<%= user.name %>" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Email</label>
          <input type="email" name="email" value="<%= user.email %>" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
      </div>
      <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold shadow-md transition-all">
        Save Changes
      </button>
    </form>
  </div>

  <!-- Saved Addresses -->
  <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm mb-8" x-data="{ showForm: false }">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-black text-slate-900">Saved Addresses</h2>
      <button @click="showForm = !showForm" class="px-4 py-2 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-md transition-all flex items-center gap-1.5">
        <i class="fas fa-plus"></i>
        <span x-text="showForm ? 'Cancel' : 'Add Address'"></span>
      </button>
    </div>

    <!-- Add Address Form -->
    <form x-show="showForm" x-cloak onsubmit="addAddress(event)" class="bg-slate-50 rounded-2xl p-6 mb-6 space-y-4 text-xs border border-slate-200/80">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Label</label>
          <select name="label" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="Home">Home</option>
            <option value="Work">Work</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Full Name</label>
          <input type="text" name="fullName" required class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Phone</label>
          <input type="tel" name="phone" required class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Street Address</label>
          <input type="text" name="street" required class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">City</label>
          <input type="text" name="city" required class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">State</label>
          <input type="text" name="state" required class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Postal Code</label>
          <input type="text" name="postalCode" required class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Country</label>
          <input type="text" name="country" value="India" required class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
      </div>
      <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
        <input type="checkbox" name="isDefault" value="true" class="rounded text-indigo-600 focus:ring-indigo-500">
        <span>Set as default address</span>
      </label>
      <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold shadow-md transition-all">
        Save Address
      </button>
    </form>

    <!-- Address List -->
    <% if (addresses && addresses.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% addresses.forEach(addr => { %>
          <div class="relative bg-slate-50 rounded-2xl p-5 border border-slate-200/80 text-xs">
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-700"><%= addr.label %></span>
              <% if (addr.isDefault) { %>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700">Default</span>
              <% } %>
            </div>
            <p class="font-bold text-slate-900"><%= addr.fullName %></p>
            <p class="text-slate-600"><%= addr.street %></p>
            <p class="text-slate-600"><%= addr.city %>, <%= addr.state %> <%= addr.postalCode %></p>
            <p class="text-slate-600"><%= addr.country %></p>
            <p class="text-slate-400 mt-1"><i class="fas fa-phone text-[10px] mr-1"></i><%= addr.phone %></p>
            <button onclick="deleteAddress('<%= addr._id %>')" class="absolute top-3 right-3 text-rose-400 hover:text-rose-600 transition-colors" title="Delete">
              <i class="fas fa-trash-can text-xs"></i>
            </button>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-8 text-slate-400">
        <i class="fas fa-map-marker-alt text-3xl mb-2"></i>
        <p class="text-xs font-semibold">No saved addresses yet. Add one above!</p>
      </div>
    <% } %>
  </div>

  <!-- Change Password -->
  <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm" x-data="{ showPw: false }">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-black text-slate-900">Change Password</h2>
      <button @click="showPw = !showPw" x-text="showPw ? 'Cancel' : 'Change'" 
              class="px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors"></button>
    </div>

    <div x-show="!showPw" class="text-xs text-slate-400">
      <i class="fas fa-lock mr-1"></i> Your password is securely hashed and stored. Click "Change" to update it.
    </div>

    <form x-show="showPw" x-cloak onsubmit="changePassword(event)" class="space-y-4 text-xs">
      <div>
        <label class="block font-bold text-slate-700 mb-1">Current Password</label>
        <input type="password" name="currentPassword" required minlength="6" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-bold text-slate-700 mb-1">New Password</label>
          <input type="password" name="newPassword" id="pw-new" required minlength="6" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Confirm Password</label>
          <input type="password" id="pw-confirm" required minlength="6" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
      </div>
      <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold shadow-md transition-all">
        Update Password
      </button>
    </form>
  </div>

</div>

<script>
async function updateProfile(e) {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData.entries());
  try {
    const res = await fetch('/api/v1/auth/updatedetails', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const result = await res.json();
    if (res.ok) {
      Cart.showToast('Profile updated!', 'success');
      setTimeout(() => location.reload(), 600);
    } else {
      Cart.showToast(result.message || 'Error updating profile', 'error');
    }
  } catch { Cart.showToast('Network error', 'error'); }
}

async function addAddress(e) {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData.entries());
  data.isDefault = data.isDefault === 'true';
  try {
    const res = await fetch('/api/v1/addresses', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const result = await res.json();
    if (res.ok) {
      Cart.showToast('Address saved!', 'success');
      setTimeout(() => location.reload(), 600);
    } else {
      Cart.showToast(result.message || 'Error saving address', 'error');
    }
  } catch { Cart.showToast('Network error', 'error'); }
}

async function deleteAddress(id) {
  if (!confirm('Delete this address?')) return;
  try {
    const res = await fetch(`/api/v1/addresses/${id}`, { method: 'DELETE' });
    if (res.ok) {
      Cart.showToast('Address deleted', 'success');
      setTimeout(() => location.reload(), 500);
    } else {
      Cart.showToast('Failed to delete address', 'error');
    }
  } catch { Cart.showToast('Network error', 'error'); }
}

async function changePassword(e) {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData.entries());
  const confirmPw = document.getElementById('pw-confirm').value;
  if (data.newPassword !== confirmPw) {
    Cart.showToast('Passwords do not match', 'error');
    return;
  }
  try {
    const res = await fetch('/api/v1/auth/updatepassword', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const result = await res.json();
    if (res.ok) {
      Cart.showToast('Password updated successfully!', 'success');
      e.target.reset();
    } else {
      Cart.showToast(result.message || 'Error updating password', 'error');
    }
  } catch { Cart.showToast('Network error', 'error'); }
}
</script>
