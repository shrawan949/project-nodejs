<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <h1 class="text-3xl font-black text-slate-900 tracking-tight mb-8">Checkout</h1>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
    
    <!-- Left Checkout Form (7 cols) -->
    <div class="lg:col-span-7">
      <form id="checkout-form" onsubmit="handlePlaceOrder(event)" class="space-y-8">
        
        <!-- Step 1: Saved Addresses / Shipping Address -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm space-y-4" x-data="{ useNew: <%= (typeof addresses === 'undefined' || !addresses || addresses.length === 0) ? 'true' : 'false' %>, selectedAddress: '<%= (typeof addresses !== 'undefined' && addresses && addresses.length > 0) ? addresses.find(a => a.isDefault)?._id || addresses[0]._id : '' %>' }">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs font-bold">1</span>
            <h3 class="text-base font-bold text-slate-900">Shipping Information</h3>
          </div>

          <!-- Saved Address Selector -->
          <% if (typeof addresses !== 'undefined' && addresses && addresses.length > 0) { %>
          <div class="space-y-3 mb-4">
            <label class="block text-xs font-bold text-slate-900 uppercase tracking-wider">Saved Addresses</label>
            <div class="space-y-2">
              <% addresses.forEach(addr => { %>
                <label class="flex items-start gap-3 p-4 rounded-2xl border cursor-pointer transition-all"
                       :class="selectedAddress === '<%= addr._id %>' && !useNew ? 'border-indigo-300 bg-indigo-50/40' : 'border-slate-200 bg-slate-50/50 hover:bg-slate-50'">
                  <input type="radio" name="savedAddress" value="<%= addr._id %>" 
                         x-model="selectedAddress" @click="useNew = false"
                         class="mt-0.5 text-indigo-600 focus:ring-indigo-500"
                         data-fullname="<%= addr.fullName %>"
                         data-phone="<%= addr.phone %>"
                         data-street="<%= addr.street %>"
                         data-city="<%= addr.city %>"
                         data-state="<%= addr.state %>"
                         data-postalcode="<%= addr.postalCode %>"
                         data-country="<%= addr.country %>">
                  <div class="text-xs">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="font-bold text-slate-900"><%= addr.fullName %></span>
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-200 text-slate-600"><%= addr.label %></span>
                      <% if (addr.isDefault) { %>
                        <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700">Default</span>
                      <% } %>
                    </div>
                    <p class="text-slate-600"><%= addr.street %>, <%= addr.city %>, <%= addr.state %> <%= addr.postalCode %></p>
                    <p class="text-slate-400 mt-0.5"><i class="fas fa-phone text-[10px] mr-1"></i><%= addr.phone %></p>
                  </div>
                </label>
              <% }) %>
            </div>
            <button type="button" @click="useNew = !useNew; if(useNew) selectedAddress = ''" 
                    class="text-xs font-bold text-indigo-600 hover:text-indigo-700 flex items-center gap-1.5 transition-colors">
              <i class="fas fa-plus text-[10px]"></i>
              <span x-text="useNew ? 'Use Saved Address' : 'Enter New Address'"></span>
            </button>
          </div>
          <% } %>

          <!-- New Address Form -->
          <div x-show="useNew" x-cloak class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="sm:col-span-2">
              <label class="block font-semibold text-slate-700 mb-1">Full Recipient Name</label>
              <input type="text" name="fullName" placeholder="John Doe" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500" :required="useNew">
            </div>

            <div class="sm:col-span-2">
              <label class="block font-semibold text-slate-700 mb-1">Street Address</label>
              <input type="text" name="street" placeholder="123 Innovation Way, Apt 4B" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500" :required="useNew">
            </div>

            <div>
              <label class="block font-semibold text-slate-700 mb-1">City</label>
              <input type="text" name="city" placeholder="San Francisco" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500" :required="useNew">
            </div>

            <div>
              <label class="block font-semibold text-slate-700 mb-1">State / Province</label>
              <input type="text" name="state" placeholder="CA" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500" :required="useNew">
            </div>

            <div>
              <label class="block font-semibold text-slate-700 mb-1">Postal / ZIP Code</label>
              <input type="text" name="postalCode" placeholder="94105" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500" :required="useNew">
            </div>

            <div>
              <label class="block font-semibold text-slate-700 mb-1">Country</label>
              <input type="text" name="country" value="United States" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500" :required="useNew">
            </div>

            <div class="sm:col-span-2">
              <label class="block font-semibold text-slate-700 mb-1">Phone Number</label>
              <input type="tel" name="phone" placeholder="+1 (555) 000-1234" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500" :required="useNew">
            </div>
          </div>
        </div>

        <!-- Step 2: Payment Method -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm space-y-4">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs font-bold">2</span>
            <h3 class="text-base font-bold text-slate-900">Payment Selection</h3>
          </div>

          <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-800 flex items-center gap-2">
            <i class="fas fa-info-circle text-amber-600"></i>
            <span><strong>Test Mode:</strong> No real payments are processed. Payment gateway integration requires credentials.</span>
          </div>

          <div class="space-y-3">
            <label class="flex items-center justify-between p-4 rounded-2xl border border-indigo-200 bg-indigo-50/40 cursor-pointer">
              <div class="flex items-center gap-3">
                <input type="radio" name="paymentMethod" value="Credit Card" checked class="text-indigo-600 focus:ring-indigo-500">
                <span class="text-xs font-bold text-slate-900">Credit / Debit Card (Test Mode)</span>
              </div>
              <div class="flex gap-2 text-slate-600 text-sm">
                <i class="fab fa-cc-visa"></i>
                <i class="fab fa-cc-mastercard"></i>
              </div>
            </label>

            <label class="flex items-center justify-between p-4 rounded-2xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 cursor-pointer">
              <div class="flex items-center gap-3">
                <input type="radio" name="paymentMethod" value="Cash on Delivery" class="text-indigo-600 focus:ring-indigo-500">
                <span class="text-xs font-bold text-slate-900">Cash on Delivery</span>
              </div>
              <i class="fas fa-hand-holding-dollar text-slate-400 text-sm"></i>
            </label>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" id="submit-order-btn" class="w-full py-4 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-xl shadow-indigo-600/20 transition-all flex items-center justify-center gap-2">
          <i class="fas fa-lock text-xs"></i>
          <span>Confirm & Complete Order</span>
        </button>

      </form>
    </div>

    <!-- Right Review Summary (5 cols) -->
    <div class="lg:col-span-5">
      <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm space-y-6 sticky top-28">
        <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider">Items in Order</h3>
        
        <div id="checkout-items" class="space-y-3 max-h-72 overflow-y-auto pr-1">
          <!-- Populated by JS -->
        </div>

        <div id="checkout-pricing" class="border-t border-slate-100 pt-4 space-y-2 text-xs text-slate-600">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>

  </div>
</div>

<script>
function renderCheckoutReview() {
  const items = Cart.getItems();
  const itemsContainer = document.getElementById('checkout-items');
  const pricingContainer = document.getElementById('checkout-pricing');

  if (items.length === 0) {
    location.href = '/cart';
    return;
  }

  itemsContainer.innerHTML = items.map(item => `
    <div class="flex items-center gap-3">
      <img src="${item.image}" alt="${item.name}" class="w-12 h-12 rounded-xl object-cover bg-slate-100 shrink-0">
      <div class="flex-1 min-w-0">
        <p class="text-xs font-bold text-slate-900 truncate">${item.name}</p>
        <p class="text-[11px] text-slate-400">Qty: ${item.qty} × $${item.price.toFixed(2)}</p>
      </div>
      <span class="text-xs font-bold text-slate-900">$${(item.price * item.qty).toFixed(2)}</span>
    </div>
  `).join('');

  const subtotal = Cart.getSubtotal();
  const savedCoupon = sessionStorage.getItem('nexus_applied_coupon') || sessionStorage.getItem('nexus_coupon');
  let discount = 0;
  let couponLabel = '';
  if (savedCoupon) {
    try {
      const c = JSON.parse(savedCoupon);
      discount = c.discountType === 'percentage' ? (subtotal * c.discountValue) / 100 : c.discountValue;
      couponLabel = c.code || '';
    } catch {}
  }

  const shipping = subtotal > 100 ? 0 : 10;
  const taxable = Math.max(0, subtotal - discount);
  const tax = Number((taxable * 0.08).toFixed(2));
  const total = Number((taxable + tax + shipping).toFixed(2));

  pricingContainer.innerHTML = `
    <div class="flex justify-between">
      <span>Subtotal</span>
      <span class="font-bold text-slate-900">$${subtotal.toFixed(2)}</span>
    </div>
    ${discount > 0 ? `
      <div class="flex justify-between text-emerald-600 font-semibold">
        <span>Discount ${couponLabel ? '(' + couponLabel + ')' : ''}</span>
        <span>-$${discount.toFixed(2)}</span>
      </div>
    ` : ''}
    <div class="flex justify-between">
      <span>Shipping</span>
      <span class="font-bold text-slate-900">${shipping === 0 ? 'FREE' : '$' + shipping.toFixed(2)}</span>
    </div>
    <div class="flex justify-between">
      <span>Estimated Tax</span>
      <span class="font-bold text-slate-900">$${tax.toFixed(2)}</span>
    </div>
    <div class="border-t border-slate-100 pt-3 flex justify-between items-baseline text-sm">
      <span class="font-black text-slate-900">Total Due</span>
      <span class="text-xl font-black text-slate-900">$${total.toFixed(2)}</span>
    </div>
  `;
}

async function handlePlaceOrder(e) {
  e.preventDefault();
  const btn = document.getElementById('submit-order-btn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Processing Order...';

  const form = e.target;
  const formData = new FormData(form);
  const items = Cart.getItems();

  const savedCoupon = sessionStorage.getItem('nexus_applied_coupon') || sessionStorage.getItem('nexus_coupon');
  let couponCode = '';
  if (savedCoupon) {
    try { couponCode = JSON.parse(savedCoupon).code; } catch {}
  }

  // Get shipping address - from saved or form inputs
  let shippingAddress;
  const selectedSaved = form.querySelector('input[name="savedAddress"]:checked');
  
  if (selectedSaved && !formData.get('fullName')) {
    // Using a saved address
    const el = selectedSaved;
    shippingAddress = {
      fullName: el.dataset.fullname,
      phone: el.dataset.phone,
      street: el.dataset.street,
      city: el.dataset.city,
      state: el.dataset.state,
      postalCode: el.dataset.postalcode,
      country: el.dataset.country,
    };
  } else {
    shippingAddress = {
      fullName: formData.get('fullName'),
      street: formData.get('street'),
      city: formData.get('city'),
      state: formData.get('state'),
      postalCode: formData.get('postalCode'),
      country: formData.get('country'),
      phone: formData.get('phone'),
    };
  }

  const payload = {
    orderItems: items.map(i => ({ product: i.id, qty: i.qty })),
    shippingAddress,
    paymentMethod: formData.get('paymentMethod'),
    couponCode,
  };

  try {
    const res = await fetch('/api/v1/orders', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const result = await res.json();

    if (res.ok) {
      Cart.clear();
      location.href = `/order-success/${result.order._id}`;
    } else {
      Cart.showToast(result.message || 'Error creating order', 'error');
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-lock text-xs"></i> <span>Confirm & Complete Order</span>';
    }
  } catch (err) {
    Cart.showToast('Network error while processing order', 'error');
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-lock text-xs"></i> <span>Confirm & Complete Order</span>';
  }
}

document.addEventListener('DOMContentLoaded', renderCheckoutReview);
</script>
