<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <h1 class="text-3xl font-black text-slate-900 tracking-tight mb-8">Express Checkout</h1>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
    
    <!-- Left Checkout Form (7 cols) -->
    <div class="lg:col-span-7">
      <form id="checkout-form" onsubmit="handlePlaceOrder(event)" class="space-y-8">
        
        <!-- Step 1: Delivery Address in India -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm space-y-4">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-black">1</span>
            <h3 class="text-base font-black text-slate-900">Delivery Address</h3>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="sm:col-span-2">
              <label class="block font-bold text-slate-700 mb-1">Full Name</label>
              <input type="text" name="fullName" required placeholder="Shrawan Ambarte" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div class="sm:col-span-2">
              <label class="block font-bold text-slate-700 mb-1">Flat, House no., Building, Apartment</label>
              <input type="text" name="street" required placeholder="Flat 402, Lotus Residency, MG Road" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">City / Town</label>
              <input type="text" name="city" required placeholder="Mumbai" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">State</label>
              <input type="text" name="state" required placeholder="Maharashtra" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">PIN Code (6 digits)</label>
              <input type="text" name="postalCode" required pattern="[0-9]{6}" placeholder="400001" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Country</label>
              <input type="text" name="country" required value="India" readonly class="w-full bg-slate-100 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-500">
            </div>

            <div class="sm:col-span-2">
              <label class="block font-bold text-slate-700 mb-1">Mobile Number for Delivery Updates</label>
              <input type="tel" name="phone" required placeholder="+91 98765 43210" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
          </div>
        </div>

        <!-- Step 2: Payment Method -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm space-y-4">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-black">2</span>
            <h3 class="text-base font-black text-slate-900">Payment Options</h3>
          </div>

          <div class="space-y-3">
            <label class="flex items-center justify-between p-4 rounded-2xl border border-blue-200 bg-blue-50/50 cursor-pointer">
              <div class="flex items-center gap-3">
                <input type="radio" name="paymentMethod" value="UPI" checked class="text-blue-600 focus:ring-blue-500">
                <div>
                  <span class="text-xs font-black text-slate-900">UPI (Google Pay, PhonePe, Paytm, QR)</span>
                  <p class="text-[11px] text-slate-500">Fastest checkout with zero transaction fees</p>
                </div>
              </div>
              <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">Instant</span>
            </label>

            <label class="flex items-center justify-between p-4 rounded-2xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 cursor-pointer">
              <div class="flex items-center gap-3">
                <input type="radio" name="paymentMethod" value="Credit Card" class="text-blue-600 focus:ring-blue-500">
                <div>
                  <span class="text-xs font-black text-slate-900">Credit / Debit Cards (Visa, MasterCard, RuPay)</span>
                  <p class="text-[11px] text-slate-500">Avail 10% instant discount on HDFC / ICICI</p>
                </div>
              </div>
              <div class="flex gap-1 text-slate-500 text-xs">
                <i class="fab fa-cc-visa"></i>
                <i class="fab fa-cc-mastercard"></i>
              </div>
            </label>

            <label class="flex items-center justify-between p-4 rounded-2xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 cursor-pointer">
              <div class="flex items-center gap-3">
                <input type="radio" name="paymentMethod" value="Cash on Delivery" class="text-blue-600 focus:ring-blue-500">
                <div>
                  <span class="text-xs font-black text-slate-900">Cash on Delivery (Pay upon delivery)</span>
                  <p class="text-[11px] text-slate-500">Pay cash or UPI to courier executive</p>
                </div>
              </div>
              <i class="fas fa-hand-holding-dollar text-slate-400 text-sm"></i>
            </label>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" id="submit-order-btn" class="w-full py-4 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-black text-sm shadow-xl shadow-blue-600/30 transition-all flex items-center justify-center gap-2">
          <i class="fas fa-lock text-xs"></i>
          <span>Place Order with Free Delivery</span>
        </button>

      </form>
    </div>

    <!-- Right Review Summary (5 cols) -->
    <div class="lg:col-span-5">
      <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm space-y-6 sticky top-28">
        <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider">Order Breakdown</h3>
        
        <div id="checkout-items" class="space-y-3 max-h-72 overflow-y-auto pr-1">
          <!-- Populated by JS -->
        </div>

        <div id="checkout-pricing" class="border-t border-slate-100 pt-4 space-y-2 text-xs text-slate-600">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>

  </div>
</div>

<script>
function renderCheckoutReview() {
  const items = Cart.getItems();
  const itemsContainer = document.getElementById('checkout-items');
  const pricingContainer = document.getElementById('checkout-pricing');

  if (items.length === 0) {
    location.href = '/cart';
    return;
  }

  itemsContainer.innerHTML = items.map(item => `
    <div class="flex items-center gap-3">
      <img src="${item.image}" alt="${item.name}" class="w-12 h-12 rounded-xl object-contain p-1 bg-slate-50 border border-slate-100 shrink-0">
      <div class="flex-1 min-w-0">
        <p class="text-xs font-bold text-slate-900 truncate">${item.name}</p>
        <p class="text-[11px] text-slate-400">Qty: ${item.qty} × ₹${Number(item.price).toLocaleString('en-IN')}</p>
      </div>
      <span class="text-xs font-black text-slate-900">₹${Number(item.price * item.qty).toLocaleString('en-IN')}</span>
    </div>
  `).join('');

  const subtotal = Cart.getSubtotal();
  const savedCoupon = sessionStorage.getItem('nexus_coupon');
  let discount = 0;
  if (savedCoupon) {
    try {
      const c = JSON.parse(savedCoupon);
      discount = c.discountType === 'percentage' ? (subtotal * c.discountValue) / 100 : c.discountValue;
    } catch {}
  }

  const shipping = subtotal > 999 ? 0 : 99;
  const taxable = Math.max(0, subtotal - discount);
  const tax = Number((taxable * 0.18).toFixed(2));
  const total = Number((taxable + tax + shipping).toFixed(2));

  pricingContainer.innerHTML = `
    <div class="flex justify-between">
      <span>Subtotal</span>
      <span class="font-bold text-slate-900">₹${subtotal.toLocaleString('en-IN')}</span>
    </div>
    ${discount > 0 ? `
      <div class="flex justify-between text-emerald-600 font-semibold">
        <span>Coupon Discount</span>
        <span>-₹${discount.toLocaleString('en-IN')}</span>
      </div>
    ` : ''}
    <div class="flex justify-between">
      <span>Delivery</span>
      <span class="font-bold text-slate-900">${shipping === 0 ? '<span class="text-emerald-600 uppercase font-extrabold">FREE</span>' : '₹' + shipping}</span>
    </div>
    <div class="flex justify-between">
      <span>GST (18%)</span>
      <span class="font-bold text-slate-900">₹${tax.toLocaleString('en-IN')}</span>
    </div>
    <div class="border-t border-slate-100 pt-3 flex justify-between items-baseline text-sm">
      <span class="font-black text-slate-900">Final Total</span>
      <span class="text-2xl font-black text-slate-900">₹${total.toLocaleString('en-IN')}</span>
    </div>
  `;
}

async function handlePlaceOrder(e) {
  e.preventDefault();
  const btn = document.getElementById('submit-order-btn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Confirming Order...';

  const form = e.target;
  const formData = new FormData(form);
  const items = Cart.getItems();

  const savedCoupon = sessionStorage.getItem('nexus_coupon');
  let couponCode = '';
  if (savedCoupon) {
    try { couponCode = JSON.parse(savedCoupon).code; } catch {}
  }

  const payload = {
    orderItems: items.map(i => ({ product: i.id, qty: i.qty })),
    shippingAddress: {
      fullName: formData.get('fullName'),
      street: formData.get('street'),
      city: formData.get('city'),
      state: formData.get('state'),
      postalCode: formData.get('postalCode'),
      country: formData.get('country'),
      phone: formData.get('phone'),
    },
    paymentMethod: formData.get('paymentMethod'),
    couponCode,
  };

  try {
    const res = await fetch('/api/v1/orders', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const result = await res.json();

    if (res.ok) {
      Cart.clear();
      location.href = `/order-success/${result.order._id}`;
    } else {
      Cart.showToast(result.message || 'Order placement failed', 'error');
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-lock text-xs"></i> <span>Place Order with Free Delivery</span>';
    }
  } catch (err) {
    Cart.showToast('Network error processing order', 'error');
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-lock text-xs"></i> <span>Place Order with Free Delivery</span>';
  }
}

document.addEventListener('DOMContentLoaded', renderCheckoutReview);
</script>
