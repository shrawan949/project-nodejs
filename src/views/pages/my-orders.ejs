<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="mb-8">
    <h1 class="text-3xl font-black text-slate-900 tracking-tight">My Order History</h1>
    <p class="text-xs text-slate-500 mt-1">Live fulfillment tracking for Samsung Appliances, Puma and Sports gear</p>
  </div>

  <% if (orders && orders.length > 0) { %>
    <div class="space-y-6">
      <% orders.forEach(order => { %>
        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm space-y-4">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2">
            <div>
              <span class="text-xs text-slate-400">Order Placed: <%= new Date(order.createdAt).toLocaleDateString() %></span>
              <p class="text-sm font-black text-slate-900"><%= order.orderNumber %></p>
            </div>
            
            <div class="flex items-center gap-3">
              <% const statusColors = {
                'Pending': 'bg-amber-50 text-amber-700 border-amber-200',
                'Processing': 'bg-blue-50 text-blue-700 border-blue-200',
                'Shipped': 'bg-purple-50 text-purple-700 border-purple-200',
                'Delivered': 'bg-emerald-50 text-emerald-700 border-emerald-200',
                'Cancelled': 'bg-rose-50 text-rose-700 border-rose-200',
              } %>
              <span class="text-xs font-bold px-3 py-1 rounded-full border <%= statusColors[order.status] || 'bg-slate-100 text-slate-700' %>">
                <%= order.status %>
              </span>
              <span class="text-sm font-black text-slate-900">₹<%= Number(order.totalPrice).toLocaleString('en-IN') %></span>
            </div>
          </div>

          <!-- Items in order -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <% order.orderItems.forEach(item => { %>
              <div class="flex items-center gap-3">
                <img src="<%= item.image %>" alt="<%= item.name %>" class="w-14 h-14 rounded-2xl object-contain p-1 bg-slate-50 border border-slate-100 shrink-0">
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-bold text-slate-900 truncate"><%= item.name %></p>
                  <p class="text-[11px] text-slate-400">Qty: <%= item.qty %> × ₹<%= Number(item.price).toLocaleString('en-IN') %></p>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Delivery Address footer -->
          <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between text-[11px] text-slate-400 gap-2">
            <span>Destination: <strong class="text-slate-700"><%= order.shippingAddress.fullName %></strong>, <%= order.shippingAddress.city %>, <%= order.shippingAddress.country %></span>
            <span>Method: <strong class="text-slate-700"><%= order.paymentMethod %></strong> (<%= order.isPaid ? 'PAID' : 'PENDING' %>)</span>
          </div>

        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-3xl border border-slate-200/80 p-16 text-center">
      <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto text-2xl mb-4">
        <i class="fas fa-box-open"></i>
      </div>
      <h3 class="text-lg font-black text-slate-900">No orders placed yet</h3>
      <p class="text-xs text-slate-400 mt-1 mb-6">Explore Samsung TVs, Washing Machines and Puma sportswear.</p>
      <a href="/shop" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md transition-all">
        <span>Start Shopping</span>
        <i class="fas fa-arrow-right text-xs"></i>
      </a>
    </div>
  <% } %>
</div>
