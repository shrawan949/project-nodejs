<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-xs text-slate-400 font-semibold mb-2">
    <a href="/" class="hover:text-indigo-600">Home</a>
    <span>/</span>
    <a href="/shop" class="hover:text-indigo-600">Shop</a>
    <span>/</span>
    <span class="text-slate-700"><%= brand.name %></span>
  </nav>

  <!-- Brand Header -->
  <div class="bg-white rounded-3xl border border-slate-200/80 p-8 mb-10 flex flex-col sm:flex-row items-center gap-6">
    <% if (brand.logo && brand.logo !== '/images/brand-placeholder.png') { %>
      <img src="<%= brand.logo %>" alt="<%= brand.name %>" class="w-20 h-20 object-contain rounded-2xl border border-slate-100 p-2">
    <% } else { %>
      <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-indigo-100 to-purple-100 flex items-center justify-center text-indigo-600 font-black text-3xl">
        <%= brand.name.charAt(0) %>
      </div>
    <% } %>
    <div class="text-center sm:text-left">
      <h1 class="text-3xl font-black text-slate-900 tracking-tight"><%= brand.name %></h1>
      <% if (brand.description) { %>
        <p class="text-sm text-slate-500 mt-1 max-w-xl"><%= brand.description %></p>
      <% } %>
      <p class="text-xs text-slate-400 mt-1"><%= totalProducts %> products available</p>
    </div>
  </div>

  <!-- Products Grid -->
  <% if (products && products.length > 0) { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% products.forEach(product => { %>
        <%- include('../partials/product-card', { product }) %>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (pages > 1) { %>
      <div class="mt-12 flex justify-center items-center gap-2">
        <% for (let i = 1; i <= pages; i++) { %>
          <a href="/brand/<%= brand.slug %>?page=<%= i %>" 
             class="w-10 h-10 rounded-xl flex items-center justify-center text-xs font-bold transition-all <%= i === page ? 'bg-indigo-600 text-white shadow-md' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50' %>">
            <%= i %>
          </a>
        <% } %>
      </div>
    <% } %>
  <% } else { %>
    <div class="bg-white rounded-3xl border border-slate-200/80 p-16 text-center">
      <i class="fas fa-box-open text-4xl text-slate-300 mb-3"></i>
      <h3 class="text-lg font-bold text-slate-800">No products from this brand yet</h3>
      <p class="text-xs text-slate-400 mt-1">Check back soon!</p>
      <a href="/shop" class="inline-block mt-4 px-6 py-2.5 bg-slate-900 text-white text-xs font-bold rounded-xl shadow-md">Browse All</a>
    </div>
  <% } %>

</div>
