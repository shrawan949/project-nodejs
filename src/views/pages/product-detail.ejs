<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10" x-data="{ mainImage: '<%= product.images[0] %>', qty: 1 }">
  
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-xs text-slate-400 font-semibold mb-8">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/shop" class="hover:text-blue-600">Catalog</a>
    <span>/</span>
    <a href="/shop?category=<%= encodeURIComponent(product.category) %>" class="hover:text-blue-600"><%= product.category %></a>
    <span>/</span>
    <span class="text-slate-800 font-bold truncate max-w-xs"><%= product.name %></span>
  </nav>

  <!-- Product Primary Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-16">
    
    <!-- Image Gallery (Col 6) -->
    <div class="lg:col-span-6 space-y-4">
      <div class="aspect-square bg-white rounded-3xl border border-slate-200/80 overflow-hidden p-8 flex items-center justify-center shadow-sm">
        <img :src="mainImage" alt="<%= product.name %>" class="w-full h-full object-contain transition-all duration-300">
      </div>
      <% if (product.images.length > 1) { %>
        <div class="flex gap-3 overflow-x-auto pb-2">
          <% product.images.forEach(img => { %>
            <button @click="mainImage = '<%= img %>'" 
                    class="w-20 h-20 rounded-2xl bg-white border border-slate-200/80 overflow-hidden p-1.5 focus:ring-2 focus:ring-blue-500 hover:border-blue-400 shrink-0 transition-all">
              <img src="<%= img %>" alt="thumb" class="w-full h-full object-contain rounded-xl">
            </button>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Product Purchasing Info (Col 6) -->
    <div class="lg:col-span-6 space-y-6">
      
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="text-[10px] font-black uppercase tracking-wider bg-slate-900 text-white px-2.5 py-0.5 rounded-md"><%= product.brand || 'Official' %></span>
          <span class="text-xs font-bold text-blue-600 uppercase tracking-wider bg-blue-50 px-2.5 py-0.5 rounded-full"><%= product.category %></span>
          <span class="text-xs text-slate-400">SKU: <%= product.sku %></span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-snug"><%= product.name %></h1>
        
        <!-- Ratings -->
        <div class="flex items-center gap-3 mt-3">
          <div class="flex text-amber-400 text-xs gap-1">
            <% for (let i = 1; i <= 5; i++) { %>
              <i class="fas fa-star <%= i <= Math.round(product.rating) ? '' : 'text-slate-200' %>"></i>
            <% } %>
          </div>
          <span class="text-xs font-bold text-slate-800"><%= product.rating.toFixed(1) %></span>
          <span class="text-xs text-slate-400">• <%= product.numReviews %> verified customer reviews</span>
        </div>
      </div>

      <!-- Indian Rupee Price Box -->
      <div class="p-5 bg-blue-50/50 rounded-2xl border border-blue-100 space-y-2">
        <div class="flex items-baseline gap-3">
          <span class="text-3xl font-black text-slate-900">₹<%= Number(product.price).toLocaleString('en-IN') %></span>
          <% if (product.compareAtPrice && product.compareAtPrice > product.price) { %>
            <span class="text-sm text-slate-400 line-through">₹<%= Number(product.compareAtPrice).toLocaleString('en-IN') %></span>
            <span class="text-xs font-black text-rose-600 bg-rose-50 px-2.5 py-1 rounded-full border border-rose-100">
              Save <%= Math.round(((product.compareAtPrice - product.price) / product.compareAtPrice) * 100) %>% (₹<%= (product.compareAtPrice - product.price).toLocaleString('en-IN') %> OFF)
            </span>
          <% } %>
        </div>
        <p class="text-[11px] text-slate-500 font-medium">Inclusive of all taxes • Free Shipping Across India</p>
      </div>

      <!-- Bank & EMI Offers Box -->
      <div class="bg-amber-50/60 border border-amber-200/80 rounded-2xl p-4 text-xs space-y-2">
        <div class="flex items-center gap-2 font-bold text-amber-950">
          <i class="fas fa-tags text-amber-600"></i>
          <span>Available Bank Offers & EMI:</span>
        </div>
        <ul class="space-y-1 text-slate-700 text-[11px]">
          <li>• <strong>Bank Offer:</strong> 10% Instant Discount up to ₹1,500 on HDFC / ICICI Credit Cards</li>
          <li>• <strong>No Cost EMI:</strong> Available starting from ₹<%= Math.round(product.price / 12).toLocaleString('en-IN') %>/month</li>
          <li>• <strong>Voucher:</strong> Extra 10% OFF with code <span class="font-mono font-bold text-blue-700 bg-white px-1.5 py-0.5 rounded">WELCOME10</span></li>
        </ul>
      </div>

      <!-- Description -->
      <p class="text-sm text-slate-600 leading-relaxed">
        <%= product.description %>
      </p>

      <!-- Inventory status -->
      <div class="flex items-center gap-2 text-xs font-bold">
        <% if (product.countInStock > 0) { %>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-emerald-700">In Stock for Immediate Dispatch (<%= product.countInStock %> units remaining)</span>
        <% } else { %>
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
          <span class="text-rose-700">Currently Out of Stock</span>
        <% } %>
      </div>

      <!-- Actions -->
      <% if (product.countInStock > 0) { %>
        <div class="space-y-3 pt-2">
          <div class="flex items-center gap-4">
            <!-- Qty Counter -->
            <div class="flex items-center border border-slate-200 bg-white rounded-2xl p-1 shadow-sm">
              <button @click="if (qty > 1) qty--" class="w-9 h-9 rounded-xl hover:bg-slate-100 flex items-center justify-center text-slate-600 text-xs">
                <i class="fas fa-minus"></i>
              </button>
              <span class="w-12 text-center text-sm font-bold text-slate-800" x-text="qty"></span>
              <button @click="if (qty < <%= product.countInStock %>) qty++" class="w-9 h-9 rounded-xl hover:bg-slate-100 flex items-center justify-center text-slate-600 text-xs">
                <i class="fas fa-plus"></i>
              </button>
            </div>

            <!-- Add to Cart Button -->
            <button @click="Cart.addItem({
                      id: '<%= product._id %>',
                      name: '<%= product.name.replace(/'/g, '') %>',
                      price: <%= product.price %>,
                      image: '<%= product.images[0] %>',
                      slug: '<%= product.slug %>',
                      countInStock: <%= product.countInStock %>
                    }, qty)" 
                    class="flex-1 py-4 px-6 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-black text-sm shadow-xl shadow-blue-600/20 flex items-center justify-center gap-2 transition-all">
              <i class="fas fa-cart-shopping text-xs"></i>
              <span>Add to Shopping Bag</span>
            </button>
          </div>

          <a href="/cart" @click="Cart.addItem({
                      id: '<%= product._id %>',
                      name: '<%= product.name.replace(/'/g, '') %>',
                      price: <%= product.price %>,
                      image: '<%= product.images[0] %>',
                      slug: '<%= product.slug %>',
                      countInStock: <%= product.countInStock %>
                    }, qty)" 
             class="block w-full py-4 px-6 rounded-2xl bg-slate-950 hover:bg-slate-800 text-white text-center font-black text-sm shadow-md transition-all">
            Buy Now with Express Checkout
          </a>
        </div>
      <% } %>

      <!-- Guarantees box -->
      <div class="border-t border-slate-200/80 pt-6 grid grid-cols-2 gap-4 text-xs text-slate-500 font-medium">
        <div class="flex items-center gap-2">
          <i class="fas fa-shield-halved text-blue-600"></i>
          <span>Official Brand Warranty</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fas fa-rotate-left text-amber-600"></i>
          <span>7-Day Easy Replacement</span>
        </div>
      </div>

    </div>

  </div>

  <!-- Customer Reviews Section -->
  <section class="border-t border-slate-200/80 pt-16 mb-16">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-black text-slate-900 mb-6">Customer Reviews (<%= product.numReviews %>)</h2>

      <!-- Reviews List -->
      <div class="space-y-4">
        <% if (product.reviews && product.reviews.length > 0) { %>
          <% product.reviews.forEach(review => { %>
            <div class="bg-white p-5 rounded-2xl border border-slate-200/70 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-900"><%= review.name %> <span class="text-emerald-600 text-[10px] ml-1 font-semibold">✓ Verified Buyer</span></span>
                <span class="text-[11px] text-slate-400"><%= new Date(review.createdAt).toLocaleDateString() %></span>
              </div>
              <div class="flex text-amber-400 text-xs gap-0.5">
                <% for (let i = 1; i <= 5; i++) { %>
                  <i class="fas fa-star <%= i <= review.rating ? '' : 'text-slate-200' %>"></i>
                <% } %>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed"><%= review.comment %></p>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-xs text-slate-400 italic">No reviews yet. Be the first to share your thoughts!</p>
        <% } %>
      </div>

    </div>
  </section>

</div>
