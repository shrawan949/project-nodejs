<!-- Big Deals Banner with Live Countdown -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
  <div class="rounded-3xl bg-gradient-to-r from-amber-500 via-orange-500 to-rose-600 p-8 sm:p-10 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="space-y-2 text-center md:text-left">
      <div class="inline-block bg-white/20 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider">
        ⚡ FLASH DEAL OF THE DAY
      </div>
      <h2 class="text-2xl sm:text-3xl font-black">Extra 10% Instant Discount on All Samsung & Puma Products</h2>
      <p class="text-xs sm:text-sm text-white/90">Use promotional coupon code <span class="bg-black/30 px-3 py-1 rounded-lg font-mono font-bold tracking-widest text-amber-200">WELCOME10</span> at checkout.</p>
    </div>

    <!-- Live Timer Box -->
    <div class="bg-slate-950/80 backdrop-blur-md rounded-2xl p-4 sm:p-6 text-center shrink-0 border border-white/10" x-data="{
      hours: 8, minutes: 42, seconds: 15,
      init() {
        setInterval(() => {
          if (this.seconds > 0) this.seconds--;
          else { this.seconds = 59; if (this.hours > 0) this.minutes--; }
        }, 1000);
      }
    }">
      <span class="text-[10px] font-bold text-amber-400 uppercase tracking-widest">Offers Ends In</span>
      <div class="flex items-center gap-3 mt-1 text-2xl font-black font-mono">
        <span x-text="String(hours).padStart(2, '0')">08</span>:<span x-text="String(minutes).padStart(2, '0')">42</span>:<span x-text="String(seconds).padStart(2, '0')">15</span>
      </div>
    </div>
  </div>
</section>

