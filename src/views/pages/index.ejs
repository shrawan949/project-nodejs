<!-- Hero Section -->
<section class="relative overflow-hidden pt-12 pb-20 bg-gradient-to-b from-indigo-50/50 via-white to-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Copy -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 bg-indigo-50 border border-indigo-100 text-indigo-700 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide">
          <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
          NEW COLLECTION DROP 2026
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tight leading-[1.1]">
          Designed for performance. <br class="hidden sm:block">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600">Built to inspire.</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-600 max-w-xl mx-auto lg:mx-0 leading-relaxed">
          Explore precision-crafted tech, ergonomic audio, and minimalist lifestyle gear built for professionals, creators, and modern explorers.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a href="/shop" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-xl shadow-slate-900/10 flex items-center justify-center gap-2 transition-all hover:-translate-y-0.5">
            <span>Explore Collection</span>
            <i class="fas fa-arrow-right text-xs"></i>
          </a>
          <a href="/shop?category=Electronics%20%26%20Gadgets" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold text-sm shadow-sm flex items-center justify-center gap-2 transition-all">
            <i class="fas fa-bolt text-indigo-600 text-xs"></i>
            <span>Featured Gadgets</span>
          </a>
        </div>

        <!-- Social Proof Stats -->
        <div class="pt-8 border-t border-slate-200/60 flex items-center justify-center lg:justify-start gap-8 sm:gap-12 text-slate-600">
          <div>
            <p class="text-2xl font-black text-slate-900">50K+</p>
            <p class="text-xs text-slate-500 font-medium">Orders Delivered</p>
          </div>
          <div class="w-px h-8 bg-slate-200"></div>
          <div>
            <p class="text-2xl font-black text-slate-900">4.9/5</p>
            <p class="text-xs text-slate-500 font-medium">Customer Rating</p>
          </div>
          <div class="w-px h-8 bg-slate-200"></div>
          <div>
            <p class="text-2xl font-black text-slate-900">24h</p>
            <p class="text-xs text-slate-500 font-medium">Fast Dispatch</p>
          </div>
        </div>

      </div>

      <!-- Right Hero Visual Showcase -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Background Glow -->
          <div class="absolute -inset-4 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-3xl blur-2xl opacity-20 -z-10"></div>
          
          <div class="relative bg-white rounded-3xl p-6 border border-slate-100 shadow-2xl space-y-4">
            <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=800&q=80" 
                 alt="Featured Product" 
                 class="w-full h-80 object-cover rounded-2xl shadow-inner">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Editor's Choice</span>
                <h3 class="text-lg font-black text-slate-900">AcousticPro ANC</h3>
              </div>
              <div class="text-right">
                <span class="text-xs text-slate-400 line-through">$349.99</span>
                <p class="text-xl font-black text-slate-900">$299.99</p>
              </div>
            </div>
            <a href="/shop" class="block w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white text-center font-bold text-xs rounded-xl shadow-md transition-all">
              Discover All Gear
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- Value Proposition Features -->
<section class="py-12 bg-white border-y border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl shrink-0">
          <i class="fas fa-truck-fast"></i>
        </div>
        <div>
          <h4 class="text-sm font-bold text-slate-900">Free Express Delivery</h4>
          <p class="text-xs text-slate-500">Free shipping on all orders over $100</p>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
          <i class="fas fa-shield-halved"></i>
        </div>
        <div>
          <h4 class="text-sm font-bold text-slate-900">Secure Payments</h4>
          <p class="text-xs text-slate-500">256-bit encrypted checkout with Stripe</p>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl shrink-0">
          <i class="fas fa-rotate-left"></i>
        </div>
        <div>
          <h4 class="text-sm font-bold text-slate-900">30-Day Easy Returns</h4>
          <p class="text-xs text-slate-500">Hassle-free money-back guarantee</p>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl shrink-0">
          <i class="fas fa-headset"></i>
        </div>
        <div>
          <h4 class="text-sm font-bold text-slate-900">24/7 Dedicated Support</h4>
          <p class="text-xs text-slate-500">Instant expert human assistance</p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Featured Products Section -->
<section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Featured Releases</span>
      <h2 class="text-3xl font-black text-slate-950 tracking-tight">Handpicked for You</h2>
    </div>
    <a href="/shop" class="text-sm font-bold text-indigo-600 hover:text-indigo-700 flex items-center gap-1.5 transition-colors">
      <span>View All Products</span>
      <i class="fas fa-arrow-right text-xs"></i>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <% if (featuredProducts && featuredProducts.length > 0) { %>
      <% featuredProducts.forEach(product => { %>
        <%- include('../partials/product-card', { product }) %>
      <% }) %>
    <% } else { %>
      <div class="col-span-full py-16 text-center text-slate-400">
        <i class="fas fa-box-open text-4xl mb-3"></i>
        <p class="text-sm font-semibold">No products seeded yet. Run <code class="bg-slate-100 text-indigo-600 px-2 py-1 rounded">npm run seed</code> in terminal.</p>
      </div>
    <% } %>
  </div>
</section>

<!-- Promo Banner Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-950 via-indigo-950 to-slate-900 p-8 sm:p-14 text-white shadow-2xl">
    <div class="relative z-10 max-w-xl space-y-4">
      <span class="inline-block bg-indigo-500 text-white text-[11px] font-black uppercase px-3 py-1 rounded-full tracking-wider">Flash Sale</span>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight leading-tight">Elevate your workspace with 20% off all tech gear.</h2>
      <p class="text-sm text-slate-300">Limited time promotion. Apply voucher code <span class="bg-white/10 px-2.5 py-1 rounded-lg font-mono font-bold text-white">NEXUS20</span> at checkout.</p>
      <div class="pt-2">
        <a href="/shop?category=Electronics%20%26%20Gadgets" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white text-slate-900 font-bold text-xs hover:bg-slate-100 transition-all">
          <span>Shop Promo Deals</span>
          <i class="fas fa-arrow-right text-xs"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Latest Arrivals Section -->
<section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between mb-10">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Fresh Drops</span>
      <h2 class="text-3xl font-black text-slate-950 tracking-tight">New Arrivals</h2>
    </div>
    <a href="/shop?sort=newest" class="text-sm font-bold text-indigo-600 hover:text-indigo-700 flex items-center gap-1.5 transition-colors">
      <span>See All</span>
      <i class="fas fa-arrow-right text-xs"></i>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <% if (newArrivals && newArrivals.length > 0) { %>
      <% newArrivals.forEach(product => { %>
        <%- include('../partials/product-card', { product }) %>
      <% }) %>
    <% } %>
  </div>
</section>
