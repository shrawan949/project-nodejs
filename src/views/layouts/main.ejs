<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Nexus MegaStore | Electronics, Puma & Appliances' %></title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              500: '#2563eb',
              600: '#1d4ed8',
              700: '#1e40af',
            },
            accent: {
              500: '#ff6b00',
              600: '#ea580c',
            }
          }
        }
      }
    }
  </script>

  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.5/dist/cdn.min.js"></script>

  <!-- Custom Styles -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased">

  <!-- Top Announcement Bar -->
  <div class="bg-slate-950 text-slate-300 text-xs py-2 px-4 text-center flex justify-center items-center gap-2">
    <span class="inline-block bg-amber-500 text-slate-950 px-2 py-0.5 rounded font-black text-[10px] uppercase tracking-wider">MEGA SALE</span>
    <span>Use code <strong class="text-amber-400">WELCOME10</strong> for 10% off • Free Express Delivery across India on orders above ₹999 • 100% Genuine Samsung & Puma Warranty</span>
  </div>

  <!-- Main Navigation -->
  <header class="sticky top-0 z-50 glass-nav border-b border-slate-200/80 transition-all" x-data="{ mobileMenu: false }">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-blue-700 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-blue-500/20 group-hover:scale-105 transition-transform">
            <i class="fas fa-bolt text-xl text-amber-300"></i>
          </div>
          <div>
            <span class="text-2xl font-black tracking-tight text-slate-950">NEXUS<span class="text-blue-600">.</span>IN</span>
            <span class="hidden sm:block text-[9px] font-black text-slate-400 tracking-widest uppercase">Mega Electronics & Sports</span>
          </div>
        </a>

        <!-- Desktop Search Bar -->
        <form action="/shop" method="GET" class="hidden md:flex items-center flex-1 max-w-lg mx-8 bg-slate-100 border border-slate-200 rounded-2xl px-4 py-2 focus-within:ring-2 focus-within:ring-blue-600 focus-within:bg-white transition-all shadow-inner">
          <i class="fas fa-search text-slate-400 text-sm mr-3"></i>
          <input type="text" name="keyword" placeholder="Search Samsung 4K TV, Puma shoes, Cricket bat, AC..." class="bg-transparent text-xs text-slate-800 placeholder-slate-400 focus:outline-none w-full">
          <button type="submit" class="text-xs font-bold text-blue-600 hover:text-blue-800 ml-2">Search</button>
        </form>

        <!-- Right Action Icons & Auth -->
        <div class="flex items-center gap-4">
          <!-- Shopping Cart Icon -->
          <a href="/cart" class="relative p-2.5 rounded-2xl hover:bg-slate-100 text-slate-800 transition-colors flex items-center gap-2">
            <div class="relative">
              <i class="fas fa-shopping-bag text-xl text-blue-600"></i>
              <span class="cart-count-badge hidden absolute -top-1 -right-1.5 bg-rose-600 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center shadow-md">0</span>
            </div>
            <span class="hidden lg:inline text-xs font-bold text-slate-700">Cart</span>
          </a>

          <!-- User Menu -->
          <% if (typeof user !== 'undefined' && user) { %>
            <div class="relative" x-data="{ open: false }">
              <button @click="open = !open" class="flex items-center gap-2 p-1.5 pl-2.5 rounded-2xl hover:bg-slate-100 transition-colors border border-slate-200">
                <span class="text-xs font-bold text-slate-800 hidden sm:inline"><%= user.name.split(' ')[0] %></span>
                <img src="<%= user.avatar %>" alt="avatar" class="w-8 h-8 rounded-xl object-cover border border-slate-200">
              </button>
              <div x-show="open" @click.away="open = false" x-cloak class="absolute right-0 mt-2 w-52 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 text-sm z-50">
                <div class="px-4 py-2 border-b border-slate-100">
                  <p class="font-bold text-slate-900 text-xs"><%= user.name %></p>
                  <p class="text-slate-400 text-[11px] truncate"><%= user.email %></p>
                </div>
                <a href="/my-orders" class="flex items-center gap-2 px-4 py-2 text-slate-700 hover:bg-slate-50 hover:text-blue-600 font-semibold text-xs">
                  <i class="fas fa-box text-xs"></i> My Orders & Tracking
                </a>
                <% if (user.role === 'admin') { %>
                  <a href="/admin" class="flex items-center gap-2 px-4 py-2 text-blue-600 font-bold hover:bg-blue-50 text-xs">
                    <i class="fas fa-chart-line text-xs"></i> Admin Dashboard
                  </a>
                <% } %>
                <a href="/api/v1/auth/logout" class="flex items-center gap-2 px-4 py-2 text-rose-600 hover:bg-rose-50 border-t border-slate-100 text-xs font-bold">
                  <i class="fas fa-sign-out-alt text-xs"></i> Sign Out
                </a>
              </div>
            </div>
          <% } else { %>
            <div class="flex items-center gap-2">
              <a href="/login" class="text-xs font-bold text-slate-700 hover:text-blue-600 px-3 py-2 rounded-xl transition-colors">Sign In</a>
              <a href="/register" class="text-xs font-black bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-xl shadow-md shadow-blue-500/20 transition-all">Sign Up</a>
            </div>
          <% } %>

          <!-- Mobile Hamburger -->
          <button @click="mobileMenu = !mobileMenu" class="md:hidden p-2 rounded-xl text-slate-700 hover:bg-slate-100">
            <i class="fas fa-bars text-lg"></i>
          </button>
        </div>

      </div>

      <!-- Categories Navigation Bar (Flipkart / Amazon Style) -->
      <div class="hidden md:flex items-center justify-between py-2.5 border-t border-slate-100 text-xs font-bold text-slate-600 overflow-x-auto">
        <a href="/shop" class="flex items-center gap-1.5 hover:text-blue-600 transition-colors whitespace-nowrap">
          <i class="fas fa-th-large text-blue-600"></i> All Departments
        </a>
        <a href="/shop?category=TVs%20%26%20Appliances" class="flex items-center gap-1.5 hover:text-blue-600 transition-colors whitespace-nowrap">
          <i class="fas fa-tv text-amber-500"></i> TVs & Appliances (Samsung)
        </a>
        <a href="/shop?category=Smartphones%20%26%20Tablets" class="flex items-center gap-1.5 hover:text-blue-600 transition-colors whitespace-nowrap">
          <i class="fas fa-mobile-screen text-indigo-500"></i> Mobiles & Galaxy S24
        </a>
        <a href="/shop?category=Puma%20%26%20Footwear" class="flex items-center gap-1.5 hover:text-blue-600 transition-colors whitespace-nowrap">
          <i class="fas fa-shoe-prints text-rose-500"></i> Puma Footwear
        </a>
        <a href="/shop?category=Sportswear%20%26%20Apparel" class="flex items-center gap-1.5 hover:text-blue-600 transition-colors whitespace-nowrap">
          <i class="fas fa-shirt text-emerald-500"></i> Puma Tracksuits & Wear
        </a>
        <a href="/shop?category=Sports%20%26%20Fitness%20Gear" class="flex items-center gap-1.5 hover:text-blue-600 transition-colors whitespace-nowrap">
          <i class="fas fa-baseball-bat-ball text-purple-500"></i> Cricket & Sports
        </a>
        <a href="/shop?category=Laptops%20%26%20Tech" class="flex items-center gap-1.5 hover:text-blue-600 transition-colors whitespace-nowrap">
          <i class="fas fa-laptop text-cyan-500"></i> Laptops & Audio
        </a>
        <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
          <a href="/admin" class="flex items-center gap-1.5 text-blue-700 bg-blue-50 px-3 py-1 rounded-lg hover:bg-blue-100 font-black">
            <i class="fas fa-shield-alt"></i> Admin Panel
          </a>
        <% } %>
      </div>

      <!-- Mobile Dropdown Nav -->
      <div x-show="mobileMenu" x-cloak class="md:hidden border-t border-slate-200 py-4 space-y-2">
        <form action="/shop" method="GET" class="flex items-center bg-slate-100 rounded-xl px-3 py-2 mb-3">
          <input type="text" name="keyword" placeholder="Search products..." class="bg-transparent text-xs w-full focus:outline-none">
          <button type="submit"><i class="fas fa-search text-slate-400 text-xs"></i></button>
        </form>
        <a href="/" class="block px-3 py-2 rounded-lg text-xs font-bold text-slate-700 hover:bg-slate-100">Home</a>
        <a href="/shop" class="block px-3 py-2 rounded-lg text-xs font-bold text-slate-700 hover:bg-slate-100">All Products</a>
        <a href="/shop?category=TVs%20%26%20Appliances" class="block px-3 py-2 rounded-lg text-xs font-bold text-slate-700 hover:bg-slate-100">Samsung TVs & Washing Machines</a>
        <a href="/shop?category=Puma%20%26%20Footwear" class="block px-3 py-2 rounded-lg text-xs font-bold text-slate-700 hover:bg-slate-100">Puma Shoes & Sneakers</a>
        <a href="/shop?category=Sports%20%26%20Fitness%20Gear" class="block px-3 py-2 rounded-lg text-xs font-bold text-slate-700 hover:bg-slate-100">Cricket & Sports Gear</a>
        <a href="/cart" class="block px-3 py-2 rounded-lg text-xs font-bold text-slate-700 hover:bg-slate-100">My Cart</a>
      </div>
    </div>
  </header>

  <!-- Body Content -->
  <main class="flex-grow">
    <%- body %>
  </main>

  <!-- Modern Indian E-Commerce Mega Footer -->
  <footer class="bg-slate-950 text-slate-400 text-sm mt-24 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-10">
        
        <!-- Brand -->
        <div class="md:col-span-2 space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-blue-600 flex items-center justify-center text-white font-bold text-lg">
              <i class="fas fa-bolt text-amber-300"></i>
            </div>
            <span class="text-2xl font-black text-white tracking-tight">NEXUS<span class="text-blue-500">.IN</span></span>
          </div>
          <p class="text-xs leading-relaxed text-slate-400 max-w-sm">
            India's premier online megastore for authentic Samsung consumer electronics, home appliances, official Puma athletic wear, and professional sports equipment.
          </p>
          <div class="flex gap-4 text-slate-400 text-base">
            <a href="#" class="hover:text-white transition-colors"><i class="fab fa-instagram"></i></a>
            <a href="#" class="hover:text-white transition-colors"><i class="fab fa-youtube"></i></a>
            <a href="#" class="hover:text-white transition-colors"><i class="fab fa-twitter"></i></a>
            <a href="#" class="hover:text-white transition-colors"><i class="fab fa-facebook"></i></a>
          </div>
        </div>

        <!-- Featured Brands -->
        <div>
          <h4 class="text-xs font-black text-white uppercase tracking-wider mb-4">Official Brands</h4>
          <ul class="space-y-2 text-xs font-medium">
            <li><a href="/shop?keyword=Samsung" class="hover:text-white transition-colors">Samsung Store</a></li>
            <li><a href="/shop?keyword=Puma" class="hover:text-white transition-colors">Puma Athletics</a></li>
            <li><a href="/shop?keyword=Apple" class="hover:text-white transition-colors">Apple Devices</a></li>
            <li><a href="/shop?keyword=Sony" class="hover:text-white transition-colors">Sony Audio & Bravia</a></li>
            <li><a href="/shop?keyword=Yonex" class="hover:text-white transition-colors">Yonex Badminton</a></li>
            <li><a href="/shop?keyword=SS" class="hover:text-white transition-colors">SS Cricket India</a></li>
          </ul>
        </div>

        <!-- Major Departments -->
        <div>
          <h4 class="text-xs font-black text-white uppercase tracking-wider mb-4">Top Departments</h4>
          <ul class="space-y-2 text-xs font-medium">
            <li><a href="/shop?category=TVs%20%26%20Appliances" class="hover:text-white transition-colors">4K Smart TVs</a></li>
            <li><a href="/shop?category=TVs%20%26%20Appliances" class="hover:text-white transition-colors">Front Load Washing Machines</a></li>
            <li><a href="/shop?category=Smartphones%20%26%20Tablets" class="hover:text-white transition-colors">Galaxy S24 Flagships</a></li>
            <li><a href="/shop?category=Puma%20%26%20Footwear" class="hover:text-white transition-colors">Nitro Running Shoes</a></li>
            <li><a href="/shop?category=Sports%20%26%20Fitness%20Gear" class="hover:text-white transition-colors">English Willow Cricket Kits</a></li>
          </ul>
        </div>

        <!-- Payment & Trust -->
        <div>
          <h4 class="text-xs font-black text-white uppercase tracking-wider mb-4">Secure Indian Payments</h4>
          <p class="text-xs text-slate-400 mb-3">Accepting UPI (GPay, PhonePe, Paytm), NetBanking, and all Indian Credit/Debit cards.</p>
          <div class="flex flex-wrap gap-2 text-xl text-slate-300">
            <span class="px-2 py-1 bg-slate-900 border border-slate-800 rounded text-xs font-black text-emerald-400">UPI</span>
            <span class="px-2 py-1 bg-slate-900 border border-slate-800 rounded text-xs font-black text-blue-400">PhonePe</span>
            <span class="px-2 py-1 bg-slate-900 border border-slate-800 rounded text-xs font-black text-cyan-400">Paytm</span>
            <span class="px-2 py-1 bg-slate-900 border border-slate-800 rounded text-xs font-black text-white">Cards</span>
          </div>
        </div>

      </div>

      <div class="mt-12 pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
        <p>&copy; 2026 Nexus MegaStore India Pvt Ltd. All prices inclusive of all taxes in INR (₹).</p>
        <p>100% Genuine Products • Free Installation on Samsung Appliances • Fast Dispatch</p>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <script src="/js/cart.js"></script>
  <div id="toast-container"></div>
</body>
</html>
