{
  "name": "nexus-ecommerce",
  "version": "1.0.0",
  "description": "Enterprise-grade, full-stack E-Commerce platform built with Node.js, Express, MongoDB, EJS, and Tailwind CSS",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/utils/seeder.js",
    "seed:destroy": "node src/utils/seeder.js -d",
    "dev:mem": "node src/dev-server.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "ecommerce",
    "tailwind",
    "jwt",
    "fullstack",
    "enterprise"
  ],
  "author": "Shrawan Ambarte",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "method-override": "^3.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
